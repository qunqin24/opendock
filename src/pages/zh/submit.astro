---
import Submit from '../../views/Submit.astro';

const code = (s: string) => `<code class="rounded bg-muted px-[0.3rem] py-[0.2rem] font-mono text-[0.8125rem] font-medium text-foreground">${s}</code>`;
---

<Submit
  meta={{
    title: '提交你的 OpenCode 插件',
    description: 'OpenDock 自动收录带 opencode-plugin 关键词的 npm 包。了解收录条件、元数据要求，用检查工具预览你的包，以及如何纠错。',
  }}
  eyebrow="写给插件作者"
  title="提交插件"
  intro={`好消息：<strong class="font-medium text-foreground">你不需要提交任何东西。</strong>只要把插件发布到 npm 并带上正确的关键词，次日就会自动收录。抓取之前，可以先用右侧的检查工具看看你的包会是什么样。`}
  stepsTitle="收录流程"
  steps={[
    {
      title: '发布到 npm',
      body: '插件必须是一个公开的 npm 包。私有包和仅存在于 GitHub 的仓库无法被自动发现。',
    },
    {
      title: '加上 opencode-plugin 关键词',
      body: '在 package.json 的 keywords 数组里加入 opencode-plugin。这是唯一的收录条件，也是整个抓取管线的入口。',
      code: `{
  "name": "opencode-your-plugin",
  "description": "一句话说清楚它解决什么问题",
  "keywords": ["opencode", "opencode-plugin"],
  "repository": "github:you/your-plugin",
  "license": "MIT"
}`,
    },
    {
      title: '填好元数据',
      body: '描述、仓库地址、协议、README 这四项决定你的健康度徽章和搜索效果。缺一项就会挂上一个警告标签。',
    },
    {
      title: '等一天',
      body: '抓取任务每天跑一次。发布后次日你的插件就会出现在列表里，无需提交 PR 或填表。',
    },
  ]}
  copyLabel="复制"
  correction={{
    title: '数据不对？分类错了？',
    body: '自动分类会出错，星标数在 monorepo 场景下也可能虚高。这些都可以通过人工覆盖层修正：在仓库里提一个 issue，说明包名和期望的修改即可。',
    cta: '提交纠错 issue',
    secondary: '了解排名算法',
    secondaryHref: '/zh/about/',
  }}
  removal={{
    title: '想要下架？',
    body: `从 package.json 里去掉 ${code('opencode-plugin')} 关键词，或者提一个 issue 申请加入屏蔽名单。两种方式下一次抓取时都会生效。`,
  }}
/>
