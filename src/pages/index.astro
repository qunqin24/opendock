---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import RankBoard from '../components/RankBoard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { rankings, categories, census } from '../lib/plugins';
import { formatNumber } from '../lib/utils';

// The hero already carries the composite ranking, so these are the views it
// can't show — the ones that answer a different question.
const boards = [
  {
    id: 'trending',
    label: '本周飙升',
    hint: '近 7 天新增星标最多的插件。总榜偏爱发布得早的项目，这里才看得到新势力。',
    plugins: rankings.trending.slice(0, 10),
    metric: 'trending' as const,
  },
  {
    id: 'downloads',
    label: '装机量',
    hint: '近 30 天 npm 下载量。比星标更难刷，最接近真实使用情况。',
    plugins: rankings.downloads.slice(0, 10),
    metric: 'downloads' as const,
  },
  {
    id: 'recent',
    label: '最新收录',
    hint: '最近发布到 npm 的 opencode 插件，按首次发布时间倒序。',
    plugins: rankings.recent.slice(0, 10),
    metric: 'recent' as const,
  },
];

const stalePct = Math.round(((census.ailing + census.abandoned) / Math.max(census.total, 1)) * 100);

// Biggest categories earn the biggest tiles — the bento layout mirrors the
// real distribution instead of a neutral alphabetical grid.
const sortedCategories = [...categories].sort((a, b) => b.count - a.count);

const theses = [
  {
    n: '01',
    title: '全量而非精选',
    body: '每天从 npm 抓取所有标注 opencode-plugin 的包，再从 GitHub 拉星标与提交记录。手工维护的列表会过时，这个不会。',
  },
  {
    n: '02',
    title: '排名不只看星标',
    body: '星标是累积量，永远偏向发布得早的项目。综合评分把装机量、维护活跃度和增长速度也算进去，让上周发布的好插件也有出头机会。',
  },
  {
    n: '03',
    title: '标出该避开的',
    body: `收录的 ${formatNumber(census.total)} 个插件里有 ${stalePct}% 已归档或长期停更。每个坞位挂一盏状态灯，不用点进去才发现。`,
  },
];
---

<Layout>
  <Hero />

  <!-- Other views ---------------------------------------------------- -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h2 class="display text-xl text-foreground sm:text-2xl">换个角度排</h2>
      <a
        href="/rankings"
        class="meta text-muted-foreground transition-colors hover:text-foreground"
      >
        完整榜单 →
      </a>
    </div>

    <RankBoard boards={boards} />
  </section>

  <!-- Categories ------------------------------------------------------ -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="display text-xl text-foreground sm:text-2xl">按需求找</h2>
        <span class="meta text-muted-foreground">{categories.length} 个分类</span>
      </div>

      <ul class="grid grid-flow-dense grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {
          sortedCategories.map((c, i) => (
            <li class:list={[i < 2 && 'col-span-2']}>
              <a
                href={`/categories/${c.id}`}
                class="group relative flex h-full flex-col justify-between gap-6 overflow-hidden rounded-xl border border-border p-5 transition-colors duration-200 hover:border-foreground hover:bg-foreground hover:text-background"
              >
                <div class="flex items-start justify-between">
                  <CategoryIcon
                    name={c.icon}
                    class="size-6 text-muted-foreground transition-colors group-hover:text-background/70"
                  />
                  <span class="tabular font-mono text-2xl font-medium text-foreground/90 group-hover:text-background">
                    {c.count}
                  </span>
                </div>

                <div>
                  <p class="truncate text-sm font-medium tracking-tight">{c.label}</p>
                  <p class="meta mt-1 truncate text-muted-foreground group-hover:text-background/60">
                    {c.labelEn}
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The argument, as a deliberate colour break ----------------------- -->
  <section class="border-t border-border bg-foreground text-background">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="display max-w-[22ch] text-[clamp(1.75rem,4.5vw,2.75rem)] leading-[1.05]">
        为什么不是<br />又一份 awesome 列表
      </h2>

      <dl class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-3">
        {
          theses.map((t) => (
            <div class="border-t border-background/20 pt-5">
              <dt class="flex items-baseline gap-3">
                <span class="tabular font-mono text-sm text-dock">{t.n}</span>
                <span class="meta text-background/70">{t.title}</span>
              </dt>
              <dd class="mt-3 text-sm leading-6 text-background/75">{t.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Submit CTA -------------------------------------------------------- -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div class="max-w-[38ch]">
          <p class="meta text-muted-foreground">收录规则</p>
          <p class="display mt-2 text-xl leading-snug text-foreground sm:text-2xl">写了插件？次日自动收录。</p>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">
            发布到 npm 并带上
            <code class="rounded border border-border bg-muted px-1 py-0.5 font-mono text-xs">opencode-plugin</code>
            关键词，接下来的每日普查会自动把它拉进港口——不用提 PR，不用等审核。
          </p>
        </div>

        <div class="flex shrink-0 flex-wrap gap-3">
          <a
            href="/submit"
            class="inline-flex items-center gap-2 rounded-lg border-2 border-foreground bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-85"
          >
            查看收录规则 →
          </a>
          <a
            href="/about"
            class="inline-flex items-center gap-2 rounded-lg border-2 border-border px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:border-foreground"
          >
            排名算法
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
