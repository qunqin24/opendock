---
import Layout from '../layouts/Layout.astro';

const steps = [
  {
    n: '01',
    title: '发布到 npm',
    body: '插件必须是一个公开的 npm 包。私有包和仅存在于 GitHub 的仓库无法被自动发现。',
  },
  {
    n: '02',
    title: '加上 opencode-plugin 关键词',
    body: '在 package.json 的 keywords 数组里加入 opencode-plugin。这是唯一的收录条件，也是整个抓取管线的入口。',
    code: `{
  "name": "opencode-your-plugin",
  "description": "一句话说清楚它解决什么问题",
  "keywords": ["opencode", "opencode-plugin"],
  "repository": "github:you/your-plugin",
  "license": "MIT"
}`,
  },
  {
    n: '03',
    title: '填好元数据',
    body: '描述、仓库地址、协议、README —— 这四项直接决定你的健康度徽章和搜索排名。缺一项就会挂上一个警告标签。',
  },
  {
    n: '04',
    title: '等一天',
    body: '抓取任务每天跑一次。发布后次日你的插件就会出现在列表里，无需提交 PR 或填表。',
  },
];
---

<Layout
  title="提交你的 opencode 插件"
  description="OpenDock 自动收录带 opencode-plugin 关键词的 npm 包。了解收录条件、元数据要求与纠错方式。"
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">提交插件</h1>
      <p class="mt-3 text-base leading-7 text-muted-foreground">
        好消息：<strong class="text-foreground">你不需要提交任何东西。</strong>
        只要把插件发布到 npm 并带上正确的关键词，我们次日就会自动收录。
      </p>
    </header>

    <ol class="space-y-8">
      {
        steps.map((s) => (
          <li class="flex gap-5">
            <span class="tabular mt-0.5 shrink-0 text-sm font-semibold text-muted-foreground">{s.n}</span>
            <div class="min-w-0 flex-1">
              <h2 class="text-base font-semibold tracking-tight">{s.title}</h2>
              <p class="mt-1.5 text-sm leading-6 text-muted-foreground">{s.body}</p>
              {s.code && (
                <div class="mt-3 overflow-hidden rounded-lg border border-border bg-card">
                  <div class="flex items-center justify-between border-b border-border bg-secondary/50 px-4 py-1.5">
                    <span class="font-mono text-[0.6875rem] text-muted-foreground">package.json</span>
                    <button
                      type="button"
                      data-copy={s.code}
                      class="rounded px-2 py-0.5 text-xs text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
                    >
                      <span data-copy-label>复制</span>
                    </button>
                  </div>
                  <pre class="overflow-x-auto px-4 py-3 font-mono text-[0.8125rem] leading-6"><code>{s.code}</code></pre>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <section class="mt-14 rounded-xl border border-border bg-card p-6">
      <h2 class="text-base font-semibold tracking-tight">数据不对？分类错了？</h2>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">
        自动分类会出错，星标数在 monorepo 场景下也可能虚高。这些都可以通过人工覆盖层修正 ——
        在仓库里提一个 issue，说明包名和期望的修改即可。
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        <a
          href="https://github.com/opendock/opendock/issues/new"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
        >
          提交纠错 issue
        </a>
        <a
          href="/about"
          class="rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium transition-colors hover:bg-secondary"
        >
          查看排名算法
        </a>
      </div>
    </section>

    <section class="mt-8 rounded-xl border border-dashed border-border p-6">
      <h2 class="text-base font-semibold tracking-tight">不想被收录？</h2>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">
        从 package.json 里移除 <code class="rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-xs">opencode-plugin</code>
        关键词，或提一个 issue 要求加入黑名单，下次抓取时就会移除。
      </p>
    </section>
  </div>
</Layout>
