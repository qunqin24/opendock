---
import Submit from '../views/Submit.astro';

const code = (s: string) => `<code class="rounded bg-muted px-[0.3rem] py-[0.2rem] font-mono text-[0.8125rem] font-medium text-foreground">${s}</code>`;
---

<Submit
  meta={{
    title: 'Submit your OpenCode plugin',
    description:
      'OpenDock indexes every npm package tagged opencode-plugin automatically. The listing requirements, the metadata that matters, a checker for your package, and how to get something corrected.',
  }}
  eyebrow="For plugin authors"
  title="Submit a plugin"
  intro={`Good news: <strong class="font-medium text-foreground">there is nothing to submit.</strong> Publish to npm with the right keyword and you are listed the next day. Use the checker to see how your package will look before the crawl gets to it.`}
  stepsTitle="How listing works"
  steps={[
    {
      title: 'Publish to npm',
      body: 'The plugin has to be a public npm package. Private packages, and repositories that only exist on GitHub, cannot be discovered automatically.',
    },
    {
      title: 'Add the opencode-plugin keyword',
      body: 'Put opencode-plugin in the keywords array of your package.json. That is the only listing requirement, and the entry point for the whole crawler.',
      code: `{
  "name": "opencode-your-plugin",
  "description": "One line on the problem it solves",
  "keywords": ["opencode", "opencode-plugin"],
  "repository": "github:you/your-plugin",
  "license": "MIT"
}`,
    },
    {
      title: 'Fill in the metadata',
      body: 'Description, repository, licence and README decide your health badges and how well search finds you. Each one missing adds a warning flag.',
    },
    {
      title: 'Wait a day',
      body: 'The crawl runs once daily. Your plugin appears the day after you publish. No pull request, no form.',
    },
  ]}
  copyLabel="Copy"
  correction={{
    title: 'Wrong data? Wrong category?',
    body: 'Automatic categorisation gets things wrong, and star counts read high for packages living inside a monorepo. Both are fixable through a manual override layer: open an issue with the package name and what should change.',
    cta: 'Open a correction issue',
    secondary: 'How ranking works',
    secondaryHref: '/about/',
  }}
  removal={{
    title: 'Want to be removed?',
    body: `Drop the ${code('opencode-plugin')} keyword from your package.json, or open an issue asking to be blocklisted. Either way the next crawl removes it.`,
  }}
/>
