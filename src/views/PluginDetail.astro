---
import Layout from '../layouts/Layout.astro';
import InstallSnippet from '../components/InstallSnippet.astro';
import PluginCard from '../components/PluginCard.astro';
import { related, categoryLabel, loadReadme, lampClass, type Plugin } from '../lib/plugins';
import { renderReadme, readmeExcerpt } from '../lib/readme';
import { avatarUrl, compactNumber, formatNumber, timeAgo, formatDate } from '../lib/utils';
import { HTML_LANG, localeFromPath, localePath, useTranslations } from '../lib/i18n';

interface Props {
  plugin: Plugin;
}
const { plugin: p } = Astro.props;

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const markdown = p.hasReadme ? await loadReadme(p.slug) : null;
const readmeHtml = markdown ? await renderReadme(markdown, { repoSlug: p.repoSlug }) : null;

const description =
  p.description ?? (markdown ? readmeExcerpt(markdown) : null) ?? t('plugin.fallbackDescription', { title: p.title });

const siblings = related(p, 3);

const stats = [
  {
    label: t('plugin.stat.stars'),
    value: formatNumber(p.stars),
    sub: p.starsDelta30d > 0 ? t('plugin.stat.starsSub', { n: compactNumber(p.starsDelta30d) }) : null,
    icon: 'star',
  },
  {
    label: t('plugin.stat.downloads'),
    value: formatNumber(p.downloadsMonth),
    sub: p.downloadsWeek > 0 ? t('plugin.stat.downloadsSub', { n: compactNumber(p.downloadsWeek) }) : null,
    icon: 'download',
  },
  {
    label: t('plugin.stat.score'),
    value: p.score.toFixed(1),
    sub: t('plugin.stat.scoreSub'),
    icon: 'score',
  },
  {
    label: t('plugin.stat.updated'),
    value: timeAgo(p.pushedAt, lang),
    sub: formatDate(p.pushedAt, lang),
    icon: 'clock',
  },
];

const meta: { label: string; value: string; href?: string; external?: boolean }[] = [
  { label: t('plugin.meta.version'), value: p.version ?? '—' },
  { label: t('plugin.meta.license'), value: p.license ?? t('plugin.meta.licenseNone') },
  {
    label: t('plugin.meta.category'),
    value: categoryLabel(p.category, lang),
    href: localePath(lang, `/categories/${p.category}`),
  },
  { label: t('plugin.meta.created'), value: formatDate(p.createdAt, lang) },
  { label: t('plugin.meta.forks'), value: formatNumber(p.forks) },
  { label: t('plugin.meta.issues'), value: formatNumber(p.openIssues) },
  ...(p.owner
    ? [{ label: t('plugin.meta.owner'), value: p.owner, href: `https://github.com/${p.owner}`, external: true }]
    : []),
];

// Rich result eligibility for "<plugin name> opencode" searches.
const site = Astro.site ?? new URL('https://www.opendock.net');
// Trailing slash to match the canonical URL — build.format is 'directory'.
const abs = (path: string) => new URL(`${localePath(lang, path).replace(/\/$/, '')}/`, site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: p.title,
      alternateName: p.name,
      description,
      url: abs(`/plugins/${p.slug}`),
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Cross-platform',
      softwareVersion: p.version ?? undefined,
      license: p.license ?? undefined,
      codeRepository: p.repoUrl ?? undefined,
      downloadUrl: p.npmUrl,
      datePublished: p.createdAt ?? undefined,
      dateModified: p.pushedAt ?? undefined,
      inLanguage: HTML_LANG[lang],
      isAccessibleForFree: true,
      author: p.owner ? { '@type': 'Person', name: p.owner, url: `https://github.com/${p.owner}` } : undefined,
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('plugin.home'), item: abs('/') },
        { '@type': 'ListItem', position: 2, name: t('plugin.allPlugins'), item: abs('/plugins') },
        {
          '@type': 'ListItem',
          position: 3,
          name: categoryLabel(p.category, lang),
          item: abs(`/categories/${p.category}`),
        },
        { '@type': 'ListItem', position: 4, name: p.title },
      ],
    },
  ],
};
---

<Layout title={t('plugin.metaTitle', { title: p.title })} description={description}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-6 flex flex-wrap items-center gap-1.5 font-mono text-xs text-muted-foreground" aria-label={t('plugin.breadcrumbAria')}>
      <a href={localePath(lang, '/')} class="transition-colors hover:text-foreground">{t('plugin.home')}</a>
      <span class="text-border">/</span>
      <a href={localePath(lang, '/plugins')} class="transition-colors hover:text-foreground">
        {t('plugin.allPlugins')}
      </a>
      <span class="text-border">/</span>
      <a href={localePath(lang, `/categories/${p.category}`)} class="transition-colors hover:text-foreground">
        {categoryLabel(p.category, lang)}
      </a>
      <span class="text-border">/</span>
      <span class="truncate text-foreground">{p.title}</span>
    </nav>

    <!-- Header: flat identity block, separated from the body by a rule
         instead of a boxed card. -->
    <header class="border-b border-border/80 pb-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0 flex-1">
          <div class="flex items-start gap-4">
            <!-- Author avatar with health lamp -->
            <div class="relative size-14 shrink-0">
              <div class="size-full overflow-hidden rounded-lg border border-border/80 bg-secondary/50">
                {
                  p.ownerAvatar ? (
                    <img
                      src={avatarUrl(p.ownerAvatar, 56)}
                      alt={p.owner ?? p.name}
                      width="56"
                      height="56"
                      loading="eager"
                      decoding="async"
                      class="size-full object-cover"
                    />
                  ) : (
                    <div class="flex size-full items-center justify-center font-mono text-lg font-medium text-foreground/70">
                      {(p.owner ?? p.name).charAt(0).toUpperCase()}
                    </div>
                  )
                }
              </div>
              <span
                class:list={[
                  'lamp absolute -top-1 -right-1 z-10 scale-125 ring-3 ring-background',
                  lampClass[p.healthLevel],
                ]}
                title={t(`health.tip.${p.healthLevel}` as const)}
              />
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h1 class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
                  {p.title}
                </h1>
                {
                  p.featured && (
                    <span class="font-mono text-[0.6875rem] font-medium uppercase tracking-wide text-amber-600 dark:text-amber-500">
                      {t('common.featured')}
                    </span>
                  )
                }
              </div>

              <!-- Package identity line: name, version, category — plain text
                   separated by middots, no chips. -->
              <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
                <code class="font-mono text-foreground/80">{p.name}</code>
                <button
                  type="button"
                  data-copy={p.name}
                  class="inline-flex items-center rounded p-0.5 text-muted-foreground transition-colors hover:text-foreground"
                  title={t('plugin.copyTitle')}
                >
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3">
                    <rect x="5.75" y="5.75" width="8.5" height="8.5" rx="1.5" />
                    <path d="M10.25 3.75v-1a1.5 1.5 0 0 0-1.5-1.5h-5.5a1.5 1.5 0 0 0-1.5 1.5v5.5a1.5 1.5 0 0 0 1.5 1.5h1" />
                  </svg>
                  <span class="sr-only" data-copy-label>{t('plugin.copy')}</span>
                </button>
                {p.version && (
                  <>
                    <span class="text-border">·</span>
                    <span class="font-mono">v{p.version}</span>
                  </>
                )}
                <span class="text-border">·</span>
                <a
                  href={localePath(lang, `/categories/${p.category}`)}
                  class="transition-colors hover:text-foreground"
                >
                  {categoryLabel(p.category, lang)}
                </a>
              </div>
            </div>
          </div>

          <p class="mt-5 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
            {description}
          </p>

          {
            p.keywords.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1.5">
                {p.keywords.slice(0, 6).map((k) => (
                  <a
                    href={localePath(lang, `/plugins?q=${encodeURIComponent(k)}`)}
                    class="font-mono text-xs text-muted-foreground transition-colors hover:text-foreground"
                  >
                    #{k}
                  </a>
                ))}
              </div>
            )
          }
        </div>

        <!-- Actions -->
        <div class="flex shrink-0 flex-wrap gap-2 lg:flex-col lg:items-stretch">
          {
            p.repoUrl && (
              <a
                href={p.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 items-center justify-center gap-2 rounded-md bg-foreground px-3.5 text-xs font-medium text-background transition-opacity hover:opacity-85"
              >
                <svg viewBox="0 0 16 16" fill="currentColor" class="size-4" aria-hidden="true">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                </svg>
                <span>{t('plugin.repo')}</span>
              </a>
            )
          }

          <a
            href={p.npmUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-9 items-center justify-center gap-2 rounded-md border border-border/80 px-3.5 text-xs font-medium text-foreground transition-colors hover:bg-secondary"
          >
            {/* npm mark. The counter is knocked out by winding direction, so
                this must stay a single path — splitting it fills the square. */}
            <svg viewBox="0 0 24 24" fill="currentColor" class="size-4 text-[#cb3837]" aria-hidden="true">
              <path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z" />
            </svg>
            <span>{t('plugin.npm')}</span>
          </a>

          {
            p.homepage && p.homepage !== p.repoUrl && (
              <a
                href={p.homepage}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 items-center justify-center gap-2 rounded-md border border-border/80 px-3.5 text-xs font-medium text-foreground transition-colors hover:bg-secondary"
              >
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4">
                  <circle cx="8" cy="8" r="6.25" />
                  <path d="M1.75 8h12.5M8 1.75a10.5 10.5 0 0 1 2.5 6.25 10.5 10.5 0 0 1-2.5 6.25 10.5 10.5 0 0 1-2.5-6.25A10.5 10.5 0 0 1 8 1.75Z" />
                </svg>
                <span>{t('plugin.homepage')}</span>
              </a>
            )
          }
        </div>
      </div>
    </header>

    <!-- Stats Strip -->
    <div class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-border/80 bg-border/80 sm:grid-cols-4">
      {
        stats.map((s) => (
          <div class="bg-card p-4 sm:p-5">
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
              {s.icon === 'star' && (
                <svg viewBox="0 0 16 16" fill="currentColor" class="size-3.5 text-amber-500" aria-hidden="true">
                  <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
                </svg>
              )}
              {s.icon === 'download' && (
                <svg viewBox="0 0 16 16" fill="currentColor" class="size-3.5" aria-hidden="true">
                  <path d="M7.25 1.75a.75.75 0 0 1 1.5 0v6.44l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V1.75ZM2.5 11a.75.75 0 0 1 .75.75v1.5h9.5v-1.5a.75.75 0 0 1 1.5 0v2.25a.75.75 0 0 1-.75-.75H2.5a.75.75 0 0 1-.75-.75v-2.25A.75.75 0 0 1 2.5 11Z" />
                </svg>
              )}
              {s.icon === 'score' && (
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" class="size-3.5" aria-hidden="true">
                  <path d="M2.5 13.5v-4M6.5 13.5v-7M10.5 13.5v-2.5M14.5 13.5v-9" stroke-linecap="round" />
                </svg>
              )}
              {s.icon === 'clock' && (
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" class="size-3.5" aria-hidden="true">
                  <circle cx="8" cy="8" r="6.25" />
                  <path d="M8 4.25v3.75l2.5 1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              <span>{s.label}</span>
            </div>
            <p class="tabular mt-2 font-mono text-2xl font-medium tracking-tight text-foreground">
              {s.value}
            </p>
            {s.sub && (
              <p class="tabular mt-1 font-mono text-xs text-muted-foreground">
                {s.sub}
              </p>
            )}
          </div>
        ))
      }
    </div>

    <!-- Main Content & Sidebar Grid -->
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <!-- Main Content Column -->
      <div class="min-w-0 space-y-10">
        <!-- Installation Section -->
        <section>
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-base font-medium tracking-tight text-foreground">{t('plugin.install')}</h2>
            <span class="font-mono text-xs text-muted-foreground">opencode.json</span>
          </div>
          <InstallSnippet plugin={p} />
          <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
            {t('plugin.installNote')}
          </p>
        </section>

        <!-- Documentation Section -->
        <section class="overflow-hidden rounded-lg border border-border/80 bg-card">
          <div class="flex items-center justify-between border-b border-border/80 px-4 py-3 sm:px-6">
            <span class="font-mono text-xs text-muted-foreground">README.md</span>

            {
              p.repoUrl && (
                <a
                  href={p.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground"
                >
                  <span>{t('plugin.readmeSource')}</span>
                  <span>→</span>
                </a>
              )
            }
          </div>

          <div class="p-6 sm:p-8">
            {
              readmeHtml ? (
                <div class="prose-readme">
                  <Fragment set:html={readmeHtml} />
                </div>
              ) : (
                <div class="rounded-lg border border-dashed border-border/80 px-6 py-14 text-center">
                  <div class="mx-auto grid size-12 place-items-center rounded-md bg-secondary text-muted-foreground">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>
                  </div>
                  <p class="mt-4 text-sm font-medium text-foreground">{t('plugin.noReadmeTitle')}</p>
                  <p class="mx-auto mt-1.5 max-w-sm text-xs leading-relaxed text-muted-foreground">
                    {t('plugin.noReadmeBody')}
                  </p>
                  {
                    p.repoUrl && (
                      <a
                        href={p.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-5 inline-flex h-9 items-center gap-1.5 rounded-md border border-border px-4 text-xs font-medium text-foreground transition-colors hover:bg-secondary"
                      >
                        {t('plugin.noReadmeCta')}
                      </a>
                    )
                  }
                </div>
              )
            }
          </div>
        </section>
      </div>

      <!-- Sidebar: borderless sections separated by hairlines, mirroring the
           /plugins filter rail. -->
      <aside class="min-w-0 space-y-8 lg:sticky lg:top-20 lg:self-start">
        <!-- Properties -->
        <section>
          <h2 class="meta text-muted-foreground">{t('plugin.properties')}</h2>
          <dl class="mt-4 divide-y divide-border/60 border-y border-border/60 text-xs">
            {
              meta.map((m) => (
                <div class="flex items-center justify-between gap-3 py-2.5">
                  <dt class="shrink-0 text-muted-foreground">{m.label}</dt>
                  <dd class="tabular truncate font-mono font-medium text-foreground">
                    {m.href ? (
                      <a
                        href={m.href}
                        target={m.external ? '_blank' : undefined}
                        rel={m.external ? 'noopener noreferrer' : undefined}
                        class="underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground"
                      >
                        {m.value}
                      </a>
                    ) : (
                      m.value
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <!-- Health -->
        <section>
          <div class="flex items-center justify-between">
            <h2 class="meta text-muted-foreground">{t('plugin.healthTitle')}</h2>
            <span class:list={['lamp', lampClass[p.healthLevel]]} title={t(`health.tip.${p.healthLevel}` as const)} />
          </div>

          <p class="mt-3 text-sm font-medium text-foreground">
            {t(`health.level.${p.healthLevel}` as const)}
          </p>
          <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
            {t(`health.tip.${p.healthLevel}` as const)}
          </p>

          <ul class="mt-4 space-y-2 border-t border-border/60 pt-4">
            {
              p.health.map((h) => (
                <li class="flex items-center gap-2 text-xs text-muted-foreground">
                  <span class:list={['size-1.5 rounded-full', h.level === 'ok' ? 'bg-ok' : h.level === 'warn' ? 'bg-warn' : 'bg-danger']} />
                  <span>{t(`health.${h.id}` as const)}</span>
                </li>
              ))
            }
          </ul>
        </section>

      </aside>
    </div>

    <!-- Related Plugins: full-width grid below the fold instead of squeezing
         cards into the sticky rail. -->
    {
      siblings.length > 0 && (
        <section class="mt-14 border-t border-border/80 pt-10">
          <h2 class="meta text-muted-foreground">{t('plugin.related')}</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {siblings.map((s) => (
              <PluginCard plugin={s} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>
