---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CompareView from '../components/CompareView';
import { categories, categoryLabel } from '../lib/plugins';
import { localeFromPath, localePath, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const categoryLabels = Object.fromEntries(categories.map((c) => [c.id, categoryLabel(c.id, lang)]));
---

<Layout title={t('compare.title')} description={t('compare.desc')}>
  <PageHeader
    title={t('compare.title')}
    description={t('compare.desc')}
    breadcrumb={[
      [t('plugin.home'), localePath(lang, '/')],
      [t('nav.plugins'), localePath(lang, '/plugins')],
      [t('compare.title')],
    ]}
    breadcrumbLabel={t('plugin.breadcrumbAria')}
  />
  <div class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <CompareView client:load lang={lang} categoryLabels={categoryLabels} />
  </div>
</Layout>
