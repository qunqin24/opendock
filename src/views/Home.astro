---
import Layout from '../layouts/Layout.astro';
import Leaderboard from '../components/Leaderboard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import {
  plugins, rankings, categories, census, totals, featured, generatedAt, categoryLabel, categoryDescription, lampClass,
} from '../lib/plugins';
import { newPluginsPerDay, sparkline, starsGainedPerDay } from '../lib/trends';
import { avatarUrl, compactNumber, formatNumber, letterAvatar } from '../lib/utils';
import { authorSlug } from '../lib/author-slug';
import { localeFromPath, localePath, pluginDescription, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const href = (path: string) => localePath(lang, path);

// "This week" is measured from the snapshot, not from build time, so the
// numbers stay true to the data they describe.
const snapshot = new Date(generatedAt).getTime();
const newThisWeek = plugins.filter((p) => p.createdAt && snapshot - new Date(p.createdAt).getTime() < 7 * 864e5).length;
const pct = (n: number) => Math.round((n / Math.max(census.total, 1)) * 100);

// --- Hero preview: the plugin index as it looks, with real rows.
const preview = rankings.top.slice(0, 5);
const previewChips = [...categories]
  .filter((c) => c.id !== 'other')
  .sort((a, b) => b.count - a.count)
  .slice(0, 4);

// --- Author wall: one face per author, best-ranked first.
const authors: { name: string; slug: string; avatar: string }[] = [];
for (const p of rankings.top) {
  const slug = authorSlug(p.owner);
  if (!slug || !p.owner || !p.ownerAvatar || authors.some((a) => a.slug === slug)) continue;
  authors.push({ name: p.owner, slug, avatar: p.ownerAvatar });
  if (authors.length === 40) break;
}

// --- Bento
const boards = [
  { id: 'top' as const, label: t('home.board.top'), plugins: rankings.top.slice(0, 10) },
  { id: 'trending' as const, label: t('home.board.trending'), plugins: rankings.trending.slice(0, 10) },
  { id: 'downloads' as const, label: t('home.board.downloads'), plugins: rankings.downloads.slice(0, 10) },
  { id: 'recent' as const, label: t('home.board.recent'), plugins: rankings.recent.slice(0, 10) },
];

const newSeries = newPluginsPerDay(30);
const newTotal = newSeries.reduce((s, p) => s + p.value, 0);
const newChart = sparkline(newSeries, 300, 72);

const starSeries = starsGainedPerDay(30);
const starTotal = starSeries.reduce((s, p) => s + p.value, 0);
const starMax = Math.max(1, ...starSeries.map((p) => p.value));

const topInstalled = rankings.downloads.slice(0, 5);
const installMax = Math.max(1, topInstalled[0]?.downloadsMonth ?? 1);

// Donut: three arcs on one circle, laid end to end.
const RING = 2 * Math.PI * 42;
let offset = 0;
const ring = [
  { label: t('home.pulse.ok'), n: census.active, stroke: 'stroke-ok', dot: 'bg-ok' },
  { label: t('home.pulse.warn'), n: census.ailing, stroke: 'stroke-warn', dot: 'bg-warn' },
  { label: t('home.pulse.danger'), n: census.abandoned, stroke: 'stroke-danger', dot: 'bg-danger' },
].map((s) => {
  const length = (s.n / Math.max(census.total, 1)) * RING;
  const arc = { ...s, length, offset };
  offset += length;
  return arc;
});

const picks = [...featured, ...rankings.top.filter((p) => !featured.includes(p))].slice(0, 3);

// Largest first; "Other" is a remainder rather than an area, so it goes last.
const sortedCategories = [...categories].sort((a, b) =>
  a.id === 'other' ? 1 : b.id === 'other' ? -1 : b.count - a.count,
);

// shadcn/ui Card anatomy, shared by every card on the page.
const card = 'relative rounded-xl border border-border bg-card text-card-foreground shadow-xs';
const cardTitle = 'leading-none font-semibold';
const cardDesc = 'text-sm text-muted-foreground';
const eyebrow = 'inline-flex items-center rounded-md border border-border bg-background px-2 py-0.5 text-xs font-medium text-muted-foreground';

const code = (s: string) =>
  `<code class="rounded bg-muted px-[0.3rem] py-[0.2rem] font-mono text-[0.8125rem] font-medium">${s}</code>`;
---

<Layout>
  {/* --- Hero ---------------------------------------------------------------- */}
  <section class="relative isolate overflow-hidden border-b border-border">
    {/* A faint grid that fades out from the top centre, and a soft glow
        behind the showcase. Both purely decorative. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_70%_55%_at_50%_0%,#000_55%,transparent_100%)]"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-[38%] left-1/2 -z-10 h-[36rem] w-[64rem] max-w-[140vw] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,oklch(0.7_0.15_265/0.22),oklch(0.75_0.12_200/0.12)_55%,transparent)] blur-2xl dark:bg-[radial-gradient(closest-side,oklch(0.55_0.2_265/0.35),oklch(0.6_0.14_200/0.15)_55%,transparent)]"
    >
    </div>

    <div class="mx-auto flex max-w-6xl flex-col items-center px-4 pt-16 text-center sm:px-6 sm:pt-24">
      <a
        href={`${href('/rankings')}#recent`}
        class="inline-flex items-center gap-2 rounded-full border border-border bg-background/80 px-3 py-1 text-sm shadow-xs backdrop-blur transition-colors hover:bg-accent"
      >
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-ok opacity-60 motion-reduce:animate-none"></span>
          <span class="relative inline-flex size-2 rounded-full bg-ok"></span>
        </span>
        {t('home.newThisWeek', { n: formatNumber(newThisWeek) })}
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 text-muted-foreground" aria-hidden="true">
          <path d="M3.5 8h9m-3.5-3.5L12.5 8 9 11.5" />
        </svg>
      </a>

      <h1 class="mt-6 max-w-4xl bg-gradient-to-b from-foreground to-foreground/65 bg-clip-text pb-1 text-4xl leading-tight font-semibold tracking-tight text-balance text-transparent sm:text-6xl sm:leading-[1.05]">
        {t('home.title', { n: formatNumber(census.total) })}
      </h1>
      <p class="mt-5 max-w-2xl text-base text-balance text-muted-foreground sm:text-lg">{t('home.subtitle')}</p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={href('/plugins')}
          class="inline-flex h-10 items-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground shadow-xs transition-[background-color,transform] hover:bg-primary/90 active:scale-[0.98]"
        >
          {t('home.browseAll')}
        </a>
        <a
          href={href('/rankings')}
          class="inline-flex h-10 items-center rounded-md border border-border bg-background px-6 text-sm font-medium shadow-xs transition-[background-color,transform] hover:bg-accent active:scale-[0.98]"
        >
          {t('home.rankingsCta')}
        </a>
      </div>

      {/* Preview: the plugin index, with real rows, in a tilted window. */}
      <div class="relative mt-14 w-full max-w-4xl [perspective:2000px] sm:mt-16">
        <figure
          class="relative overflow-hidden rounded-t-xl border border-b-0 border-border bg-card text-left shadow-2xl shadow-black/10 sm:origin-bottom sm:[transform:rotateX(10deg)] dark:shadow-black/50"
        >
          <div class="flex items-center gap-3 border-b border-border bg-muted/40 px-4 py-2.5">
            <span class="flex gap-1.5" aria-hidden="true">
              <span class="size-2.5 rounded-full bg-[#ff5f57] ring-1 ring-black/10 ring-inset"></span>
              <span class="size-2.5 rounded-full bg-[#febc2e] ring-1 ring-black/10 ring-inset"></span>
              <span class="size-2.5 rounded-full bg-[#28c840] ring-1 ring-black/10 ring-inset"></span>
            </span>
            <span class="mx-auto rounded-md border border-border bg-background px-3 py-0.5 font-mono text-[0.6875rem] text-muted-foreground">
              opendock.net/plugins
            </span>
            <span class="w-[42px]" aria-hidden="true"></span>
          </div>

          <div class="px-4 pt-5 pb-28 sm:px-6" aria-hidden="true">
            <div class="flex h-10 items-center gap-2.5 rounded-lg border border-input bg-background px-3 text-sm text-muted-foreground shadow-xs">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 shrink-0"><circle cx="7" cy="7" r="4.75" /><path d="m10.5 10.5 3.5 3.5" stroke-linecap="round" /></svg>
              <span class="truncate">{t('palette.placeholder')}</span>
              <kbd class="ml-auto rounded border border-border bg-muted px-1.5 font-mono text-[0.625rem]">⌘K</kbd>
            </div>
            <div class="mt-3 flex gap-2 overflow-hidden">
              <span class="shrink-0 rounded-full bg-primary px-3 py-1 text-xs font-medium text-primary-foreground">{t('home.preview.all')}</span>
              {previewChips.map((c) => (
                <span class="shrink-0 rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">{categoryLabel(c.id, lang)}</span>
              ))}
            </div>
            <div class="mt-4 flex items-center justify-between border-b border-border pb-2 text-xs text-muted-foreground">
              <span>{t('explorer.col.plugin')}</span>
              <span class="flex gap-8"><span>{t('explorer.col.stars')}</span><span class="hidden sm:inline">{t('explorer.col.downloads')}</span></span>
            </div>
            <ol class="divide-y divide-border">
              {
                preview.map((p) => (
                  <li class="flex items-center gap-3 py-3">
                    <span class="relative size-8 shrink-0">
                      <span class="block size-full overflow-hidden rounded-md border border-border bg-muted">
                        {p.ownerAvatar ? (
                          <img src={avatarUrl(p.ownerAvatar, 32)} alt="" width="32" height="32" class="size-full object-cover" loading="lazy" decoding="async" />
                        ) : (
                          <span class="grid size-full place-items-center text-xs font-medium text-white" style={`background:${letterAvatar(p.title).color}`}>{letterAvatar(p.title).letter}</span>
                        )}
                      </span>
                      <span class:list={['lamp absolute -right-0.5 -bottom-0.5 ring-2 ring-card', lampClass[p.healthLevel]]} />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-sm font-medium">{p.title}</span>
                      <span class="block truncate text-xs text-muted-foreground">{pluginDescription(p, lang) ?? p.name}</span>
                    </span>
                    <span class="hidden shrink-0 rounded-md border border-border px-2 py-0.5 text-xs text-muted-foreground md:inline">
                      {categoryLabel(p.category, lang)}
                    </span>
                    <span class="tabular w-12 shrink-0 text-right text-sm font-medium">{compactNumber(p.stars)}</span>
                    <span class="tabular hidden w-14 shrink-0 text-right text-sm text-muted-foreground sm:inline">{compactNumber(p.downloadsMonth)}</span>
                  </li>
                ))
              }
            </ol>
          </div>

          {/* Fade into the page, with the way in sitting on the fade. */}
          <div class="absolute inset-x-0 bottom-0 flex h-36 items-end justify-center bg-gradient-to-t from-background via-background/90 to-transparent pb-6">
            <a
              href={href('/plugins')}
              class="inline-flex h-9 items-center gap-1.5 rounded-full bg-primary px-4 text-sm font-medium text-primary-foreground shadow-lg transition-transform hover:scale-[1.02] active:scale-[0.98]"
            >
              {t('home.preview.browse', { n: formatNumber(census.total) })} <span aria-hidden="true">→</span>
            </a>
          </div>
        </figure>
      </div>
    </div>
  </section>

  {/* --- Author wall ------------------------------------------------------------ */}
  <section class="border-b border-border py-8" aria-label={t('home.authors', { n: formatNumber(totals.maintainers) })}>
    <p class="text-center text-sm text-muted-foreground">
      {t('home.authors', { n: formatNumber(totals.maintainers) })}
    </p>
    <div class="group/marquee relative mt-5 overflow-hidden [mask-image:linear-gradient(to_right,transparent,#000_12%,#000_88%,transparent)]">
      <ul class="marquee flex w-max gap-3 group-hover/marquee:[animation-play-state:paused]">
        {
          // Doubled so the loop is seamless; the second copy is hidden from
          // assistive tech and the tab order so each author is reachable once.
          [...authors, ...authors].map((a, i) => {
            const copy = i >= authors.length;
            return (
              <li class="shrink-0" aria-hidden={copy ? 'true' : undefined}>
                <a
                  href={href(`/authors/${a.slug}`)}
                  title={a.name}
                  aria-label={t('plugin.byOwnerAria', { owner: a.name })}
                  tabindex={copy ? -1 : undefined}
                  class="block size-10 overflow-hidden rounded-full border border-border bg-muted transition-[border-color,transform] hover:scale-110 hover:border-foreground/30 motion-reduce:hover:scale-100"
                >
                  <img src={avatarUrl(a.avatar, 40)} alt="" width="40" height="40" class="size-full object-cover" loading="lazy" decoding="async" />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <div class="mx-auto max-w-6xl space-y-24 px-4 py-20 sm:px-6 sm:py-24">
    {/* --- Overview bento ------------------------------------------------------- */}
    <section aria-labelledby="overview-title" data-reveal>
      <div class="mx-auto max-w-2xl text-center">
        <span class={eyebrow}>{t('home.overview.eyebrow')}</span>
        <h2 id="overview-title" class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{t('home.overview.title')}</h2>
        <p class={`mt-3 ${cardDesc} sm:text-base`}>{t('home.overview.desc')}</p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 lg:grid-cols-6">
        {/* Leaderboard: the big tile */}
        <div class={`${card} min-w-0 lg:col-span-4 lg:row-span-2`}>
          <div class="flex flex-wrap items-start justify-between gap-3 px-6 pt-6">
            <div class="space-y-1.5">
              <h3 class={cardTitle}>{t('home.board.title')}</h3>
              <p class={cardDesc}>{t('home.board.desc')}</p>
            </div>
            <a href={href('/rankings')} class="inline-flex h-8 items-center rounded-md px-3 text-sm font-medium transition-colors hover:bg-accent">
              {t('home.board.all')} <span aria-hidden="true" class="ml-1">→</span>
            </a>
          </div>
          <div class="px-6 pt-5 pb-4">
            <Leaderboard boards={boards} />
          </div>
        </div>

        {/* New plugins: area chart */}
        <div class={`${card} flex min-w-0 flex-col overflow-hidden lg:col-span-2`}>
          <div class="space-y-2 px-6 pt-6">
            <p class={cardDesc}>{t('home.stat.indexed')}</p>
            <p class="tabular text-3xl font-semibold tracking-tight">
              <span data-count={census.total}>{formatNumber(census.total)}</span>
            </p>
            <p class="text-xs text-muted-foreground">{t('home.bento.new')} · {t('home.bento.newFoot', { n: formatNumber(newTotal) })}</p>
          </div>
          <svg viewBox="0 0 300 72" preserveAspectRatio="none" class="mt-auto h-24 w-full text-foreground" aria-hidden="true">
            <defs>
              <linearGradient id="new-fill" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="currentColor" stop-opacity="0.18" />
                <stop offset="1" stop-color="currentColor" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path d={newChart.area} fill="url(#new-fill)" />
            <path d={newChart.line} fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
          </svg>
        </div>

        {/* Stars gained: bar chart */}
        <div class={`${card} flex min-w-0 flex-col lg:col-span-2`}>
          <div class="space-y-2 px-6 pt-6">
            <p class={cardDesc}>{t('home.stat.stars')}</p>
            <p class="tabular text-3xl font-semibold tracking-tight">
              <span data-count={totals.stars} data-compact>{compactNumber(totals.stars)}</span>
            </p>
            <p class="text-xs text-muted-foreground">{t('home.bento.stars')} · {t('home.bento.starsFoot', { n: compactNumber(starTotal) })}</p>
          </div>
          <div class="mt-auto flex h-24 items-end gap-[3px] px-6 pt-4 pb-6" aria-hidden="true">
            {
              starSeries.map((p) => (
                <span
                  class:list={[
                    'flex-1 rounded-t-[2px] transition-colors',
                    // Days the star history has no reading for stay faint
                    // rather than reading as a quiet day.
                    p.value ? 'bg-foreground/80 hover:bg-foreground' : 'bg-border',
                  ]}
                  style={`height:${Math.max(4, (p.value / starMax) * 100)}%`}
                  title={`${p.date} +${formatNumber(p.value)}`}
                />
              ))
            }
          </div>
        </div>

        {/* Health: donut */}
        <div class={`${card} flex min-w-0 flex-col p-6 lg:col-span-2`}>
          <div class="space-y-1.5">
            <h3 class={cardTitle}>{t('home.health.title')}</h3>
            <p class={cardDesc}>{t('home.health.desc')}</p>
          </div>
          <div class="mt-6 flex items-center gap-6">
            <div class="relative size-28 shrink-0">
              <svg viewBox="0 0 100 100" class="size-full -rotate-90" aria-hidden="true">
                <circle cx="50" cy="50" r="42" fill="none" class="stroke-muted" stroke-width="12" />
                {
                  ring.map((s) => (
                    <circle
                      cx="50"
                      cy="50"
                      r="42"
                      fill="none"
                      class={s.stroke}
                      stroke-width="12"
                      stroke-dasharray={`${s.length} ${RING - s.length}`}
                      stroke-dashoffset={-s.offset}
                    />
                  ))
                }
              </svg>
              <div class="absolute inset-0 grid place-content-center text-center">
                <span class="tabular text-xl font-semibold">{pct(census.active)}%</span>
                <span class="text-[0.6875rem] text-muted-foreground">{t('home.bento.maintained')}</span>
              </div>
            </div>
            <dl class="min-w-0 flex-1 space-y-2.5 text-sm">
              {
                ring.map((s) => (
                  <div class="flex items-center justify-between gap-3">
                    <dt class="flex items-center gap-2">
                      <span class:list={['size-2 rounded-full', s.dot]} aria-hidden="true" />
                      {s.label}
                    </dt>
                    <dd class="tabular text-muted-foreground">{formatNumber(s.n)}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>

        {/* Most installed: horizontal bars */}
        <div class={`${card} flex min-w-0 flex-col p-6 lg:col-span-2`}>
          <div class="space-y-1.5">
            <h3 class={cardTitle}>{t('home.bento.installs')}</h3>
            <p class={cardDesc}>{t('home.bento.installsFoot', { n: compactNumber(totals.downloadsMonth) })}</p>
          </div>
          <ol class="mt-5 space-y-3">
            {
              topInstalled.map((p) => (
                <li>
                  <a href={href(`/plugins/${p.slug}`)} class="group block">
                    <span class="flex items-baseline justify-between gap-3 text-sm">
                      <span class="truncate font-medium group-hover:underline group-hover:underline-offset-4">{p.title}</span>
                      <span class="tabular shrink-0 text-xs text-muted-foreground">{compactNumber(p.downloadsMonth)}</span>
                    </span>
                    <span class="mt-1.5 block h-1.5 overflow-hidden rounded-full bg-muted">
                      <span class="block h-full rounded-full bg-foreground/80" style={`width:${(p.downloadsMonth / installMax) * 100}%`} />
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>

        {/* Editors' picks */}
        <div class={`${card} flex min-w-0 flex-col lg:col-span-2`}>
          <div class="space-y-1.5 px-6 pt-6">
            <h3 class={cardTitle}>{t('home.picks.title')}</h3>
            <p class={cardDesc}>{t('home.picks.desc')}</p>
          </div>
          <ul class="space-y-1 p-3">
            {
              picks.map((p) => (
                <li>
                  <a href={href(`/plugins/${p.slug}`)} class="flex items-center gap-3 rounded-lg p-3 transition-colors hover:bg-accent">
                    <span class="size-8 shrink-0 overflow-hidden rounded-md border border-border bg-muted">
                      {p.ownerAvatar ? (
                        <img src={avatarUrl(p.ownerAvatar, 32)} alt="" width="32" height="32" class="size-full object-cover" loading="lazy" decoding="async" />
                      ) : (
                        <span class="grid size-full place-items-center text-xs font-medium text-white" style={`background:${letterAvatar(p.title).color}`}>{letterAvatar(p.title).letter}</span>
                      )}
                    </span>
                    <span class="min-w-0">
                      <span class="block truncate text-sm font-medium">{p.title}</span>
                      <span class="block truncate text-xs text-muted-foreground">{pluginDescription(p, lang) ?? t('common.noDescription')}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* --- Categories ------------------------------------------------------------- */}
    <section aria-labelledby="cats-title" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class={eyebrow}>{t('home.cats.eyebrow')}</span>
          <h2 id="cats-title" class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{t('home.cats.title')}</h2>
          <p class={`mt-3 ${cardDesc} sm:text-base`}>{t('home.cats.desc', { n: categories.length })}</p>
        </div>
        <a
          href={href('/categories')}
          class="inline-flex h-9 items-center rounded-md border border-border bg-background px-4 text-sm font-medium shadow-xs transition-colors hover:bg-accent"
        >
          {t('home.cats.all')}
        </a>
      </div>

      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          sortedCategories.map((c) => (
            <li>
              <a
                href={href(`/categories/${c.id}`)}
                data-spotlight
                class={`${card} spotlight group flex h-full flex-col gap-4 overflow-hidden p-5 transition-[border-color,transform] hover:-translate-y-0.5 hover:border-foreground/20`}
              >
                <div class="flex items-center justify-between">
                  <span class="grid size-10 place-items-center rounded-lg border border-border bg-gradient-to-b from-background to-muted shadow-xs">
                    <CategoryIcon name={c.icon} class="size-[18px]" />
                  </span>
                  <span class="tabular text-2xl font-semibold tracking-tight text-foreground/90">{formatNumber(c.count)}</span>
                </div>
                <div>
                  <h3 class="text-sm font-medium">{categoryLabel(c.id, lang)}</h3>
                  <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{categoryDescription(c.id, lang)}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {/* --- Publish ----------------------------------------------------------------- */}
