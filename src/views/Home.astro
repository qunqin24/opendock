---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturedSpotlight from '../components/FeaturedSpotlight.astro';
import RankBoard from '../components/RankBoard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { rankings, categories, census, featured, categoryLabel, categoryDescription } from '../lib/plugins';
import { formatNumber } from '../lib/utils';
import { localeFromPath, localePath, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);

// Curation first, then the composite board tops it up. Falling back to
// `rankings.top` wholesale would silently drop the featured picks whenever
// there are fewer than four of them.
const spotlightPlugins = [...featured, ...rankings.top.filter((p) => !featured.includes(p))].slice(0, 4);

// The hero already carries the composite ranking, so these boards are the
// views it can't show — the ones that answer a different question.
const boards = [
  {
    id: 'trending',
    label: t('board.trending'),
    hint: t('board.trending.hint'),
    plugins: rankings.trending.slice(0, 8),
    metric: 'trending' as const,
  },
  {
    id: 'downloads',
    label: t('board.downloads'),
    hint: t('board.downloads.hint'),
    plugins: rankings.downloads.slice(0, 8),
    metric: 'downloads' as const,
  },
  {
    id: 'top',
    label: t('board.top'),
    hint: t('board.top.hint'),
    plugins: rankings.top.slice(0, 8),
    metric: 'top' as const,
  },
  {
    id: 'recent',
    label: t('board.recent'),
    hint: t('board.recent.hint'),
    plugins: rankings.recent.slice(0, 8),
    metric: 'recent' as const,
  },
];

// Sort categories by plugin counts
const sortedCategories = [...categories].sort((a, b) => b.count - a.count);

const features = ([1, 2, 3, 4] as const).map((n) => ({
  tag: t(`home.feature.${n}.tag` as const),
  title: t(`home.feature.${n}.title` as const),
  desc: t(`home.feature.${n}.desc` as const, { total: formatNumber(census.total) }),
}));
---

<Layout>
  <!-- 1. Hero Section ------------------------------------------------ -->
  <Hero />

  <!-- 2. Featured Spotlight Section ----------------------------------- -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <div class="inline-flex items-center gap-1.5 rounded-md bg-secondary px-2 py-0.5 font-mono text-[0.6875rem] font-semibold text-foreground/80">
          {t('home.spotlight.eyebrow')}
        </div>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
          {t('home.spotlight.title')}
        </h2>
        <p class="mt-1 text-sm text-muted-foreground">
          {t('home.spotlight.subtitle')}
        </p>
      </div>

      <a
        href={localePath(lang, "/plugins")}
        class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
      >
        {t('home.spotlight.viewAll', { total: formatNumber(census.total) })} <span aria-hidden="true">→</span>
      </a>
    </div>

    <FeaturedSpotlight plugins={spotlightPlugins} />
  </section>

  <!-- 3. Multi-dimensional Rankings Section -------------------------- -->
  <section class="border-t border-border/80 bg-secondary/20 py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <div class="inline-flex items-center gap-1.5 rounded-md bg-secondary px-2 py-0.5 font-mono text-[0.6875rem] font-semibold text-foreground/80">
            {t('home.boards.eyebrow')}
          </div>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
            {t('home.boards.title')}
          </h2>
          <p class="mt-1 text-sm text-muted-foreground">
            {t('home.boards.subtitle')}
          </p>
        </div>

        <a
          href={localePath(lang, "/rankings")}
          class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >
          {t('home.boards.viewAll')} <span aria-hidden="true">→</span>
        </a>
      </div>

      <RankBoard boards={boards} />
    </div>
  </section>

  <!-- 4. Category Grid Section --------------------------------------- -->
  <section class="border-t border-border/80 py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <div class="inline-flex items-center gap-1.5 rounded-md bg-secondary px-2 py-0.5 font-mono text-[0.6875rem] font-semibold text-foreground/80">
            {t('home.taxonomy.eyebrow')}
          </div>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
            {t('home.taxonomy.title')}
          </h2>
          <p class="mt-1 text-sm text-muted-foreground">
            {t('home.taxonomy.subtitle', { n: categories.length })}
          </p>
        </div>

        <a
          href={localePath(lang, "/categories")}
          class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >
          {t('home.taxonomy.viewAll')} <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          sortedCategories.map((c) => (
            <a
              href={localePath(lang, `/categories/${c.id}`)}
              class="group relative flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-foreground/30 hover:bg-secondary/40 hover:shadow-xs"
            >
              <div>
                <div class="flex items-center justify-between">
                  <div class="grid size-10 place-items-center rounded-xl bg-secondary text-foreground/80 transition-colors group-hover:bg-foreground group-hover:text-background">
                    <CategoryIcon name={c.icon} class="size-5" />
                  </div>
                  <span class="tabular rounded-full bg-secondary/80 px-2 py-0.5 font-mono text-xs font-semibold text-muted-foreground group-hover:text-foreground">
                    {t('home.taxonomy.count', { n: c.count })}
                  </span>
                </div>

                <div class="mt-4">
                  <h3 class="text-base font-semibold tracking-tight text-foreground group-hover:text-foreground">
                    {categoryLabel(c.id, lang)}
                  </h3>
                  <p class="font-mono text-[0.6875rem] text-muted-foreground/70">
                    {c.labelEn}
                  </p>
                  <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-muted-foreground">
                    {categoryDescription(c.id, lang)}
                  </p>
                </div>
              </div>

              <div class="mt-4 flex items-center justify-end text-xs font-medium text-muted-foreground group-hover:text-foreground">
                <span class="group-hover:translate-x-0.5 transition-transform">{t('home.taxonomy.explore')} →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5. OpenDock Philosophy / Bento Feature Section ------------------ -->
  <section class="border-t border-border/80 bg-secondary/30 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <div class="inline-flex items-center gap-1.5 rounded-md bg-secondary px-2.5 py-1 font-mono text-xs font-semibold text-foreground/80">
          {t('home.philosophy.eyebrow')}
        </div>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
          {t('home.philosophy.title')}
        </h2>
        <p class="mt-3 text-sm text-muted-foreground sm:text-base">
          {t('home.philosophy.subtitle')}
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-2">
        {
          features.map((f, i) => (
            <div class="relative overflow-hidden rounded-2xl border border-border/80 bg-card p-7 transition-all hover:border-foreground/20 hover:shadow-xs">
              <div class="flex items-center justify-between">
                <span class="rounded-md border border-border/60 bg-secondary/70 px-2 py-0.5 font-mono text-[0.6875rem] font-semibold text-foreground/80">
                  {f.tag}
                </span>
                <span class="tabular font-mono text-xs font-bold text-dock">
                  0{i + 1}
                </span>
              </div>

              <h3 class="mt-4 text-lg font-bold tracking-tight text-foreground">
                {f.title}
              </h3>

              <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                {f.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Developer Quick-Start & Submit CTA --------------------------- -->
  <section class="border-t border-border/80 py-14 sm:py-18">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-3xl border border-border bg-gradient-to-br from-card via-card to-secondary/40 p-8 sm:p-12 shadow-sm">
        {/* Glow accent */}
        <div class="pointer-events-none absolute -right-20 -bottom-20 size-72 rounded-full bg-dock/15 blur-3xl" aria-hidden="true" />

        <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
          <!-- Left CTA content -->
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-1.5 rounded-full border border-dock/30 bg-dock/10 px-3 py-0.5 text-xs font-medium text-dock">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" class="size-3.5">
                <path d="m3.5 12.5 1.5-4 4-1.5 4.5-4.5c.8-.8 2-.8 2.8 0s.8 2 0 2.8l-4.5 4.5-1.5 4-4 1.5-.8-.8 1.5-1.5-.7-.7-1.5 1.5-.8-.8Z" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{t('home.cta.badge')}</span>
            </div>

            <h2 class="mt-4 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
              {t('home.cta.title')}
            </h2>

            <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
              <Fragment
                set:html={t('home.cta.desc', {
                  manifest:
                    '<code class="rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground font-semibold">package.json</code>',
                  keyword:
                    '<code class="rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground font-semibold">opencode-plugin</code>',
                })}
              />
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a
                href={localePath(lang, "/submit")}
                class="inline-flex items-center gap-2 rounded-xl bg-foreground px-5 py-2.5 text-sm font-semibold text-background transition-opacity hover:opacity-90 shadow-sm"
              >
                {t('home.cta.rules')} →
              </a>
              <a
                href={localePath(lang, "/about")}
                class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-secondary"
              >
                {t('home.cta.algorithm')}
              </a>
            </div>
          </div>

          <!-- Right: Code snippet illustration -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-border bg-muted/60 p-4 font-mono text-xs shadow-inner">
              <div class="mb-3 flex items-center justify-between border-b border-border/60 pb-2.5 text-[0.6875rem] text-muted-foreground">
                <span class="flex items-center gap-1.5">
                  <span class="size-2.5 rounded-full bg-red-400/80"></span>
                  <span class="size-2.5 rounded-full bg-amber-400/80"></span>
                  <span class="size-2.5 rounded-full bg-green-400/80"></span>
                  <span class="ml-1 font-semibold text-foreground/80">package.json</span>
                </span>
                <span>npm keyword</span>
              </div>
              <pre class="overflow-x-auto text-[0.8125rem] leading-relaxed text-foreground/90"><code>&#123;
  <span class="text-amber-500">"name"</span>: <span class="text-ok">"opencode-my-plugin"</span>,
  <span class="text-amber-500">"keywords"</span>: [
    <span class="text-ok font-semibold">"opencode-plugin"</span>,
    <span class="text-ok">"agent"</span>,
    <span class="text-ok">"workflow"</span>
  ]
&#125;</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
