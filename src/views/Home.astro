<style>
  /* Author wall: one copy of the list scrolls past, the second copy closes
     the loop seamlessly at -50%. */
  .marquee {
    animation: marquee 60s linear infinite;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Category cards: a soft light follows the pointer. */
  .spotlight::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
    background: radial-gradient(
      260px circle at var(--x, 50%) var(--y, 50%),
      color-mix(in oklch, var(--foreground) 7%, transparent),
      transparent 70%
    );
  }
  @media (hover: hover) and (pointer: fine) {
    .spotlight:hover::before {
      opacity: 1;
    }
  }

  /* Sections below the fold rise in once as they scroll into view. Only
     applied once the script has run, so nothing is hidden without JS. */
  :global(.reveal-ready) [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 700ms ease-out,
      transform 700ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  :global(.reveal-ready) [data-reveal].in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
    }
    :global(.reveal-ready) [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { compactNumber, formatNumber } from '../lib/utils';

  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Counts a figure up from zero the first time it scrolls into view. The
  // final value is already in the markup, so crawlers and no-JS readers see
  // the real number.
  function countUp(el: HTMLElement) {
    const target = Number(el.dataset.count);
    const compact = 'compact' in el.dataset;
    // Same formatters as the server render, so the last frame matches it.
    const format = (n: number) => (compact ? compactNumber(Math.round(n)) : formatNumber(Math.round(n)));
    const final = el.textContent;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / 1200);
      el.textContent = p < 1 ? format(target * (1 - Math.pow(1 - p, 3))) : final;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('[data-reveal]')) return;

    if (!reduced()) document.documentElement.classList.add('reveal-ready');
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          seen.unobserve(el);
          if (el.matches('[data-reveal]')) el.classList.add('in');
          else if (!reduced()) countUp(el);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    document.querySelectorAll<HTMLElement>('[data-reveal], [data-count]').forEach((el) => seen.observe(el));
  });

  // Pointer position for the category spotlight, delegated so it survives
  // soft navigation.
  document.addEventListener('pointermove', (event) => {
    const el = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-spotlight]');
    if (!el) return;
    const r = el.getBoundingClientRect();
    el.style.setProperty('--x', `${event.clientX - r.left}px`);
    el.style.setProperty('--y', `${event.clientY - r.top}px`);
  });
</script>
