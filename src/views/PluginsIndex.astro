---
import Layout from '../layouts/Layout.astro';
import PluginExplorer from '../components/PluginExplorer';
import { searchDocs, categories, plugins } from '../lib/plugins';
import { localeFromPath, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
---

<Layout title={t('plugins.title')} description={t('plugins.metaDescription', { n: plugins.length })}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="mb-8">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t('plugins.heading')}</h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground">
        {t('plugins.intro.before', { n: plugins.length })}<kbd
          class="rounded border border-border bg-muted px-1.5 py-px font-mono text-[0.6875rem]">/</kbd
        >{t('plugins.intro.after')}
      </p>
    </header>

    <PluginExplorer client:load docs={searchDocs} categories={categories} lang={lang} />
  </div>
</Layout>
