---
import Layout from '../layouts/Layout.astro';
import PluginExplorer from '../components/PluginExplorer';
import { searchDocsFor, categories, plugins, generatedAt } from '../lib/plugins';
import { formatDate, formatNumber } from '../lib/utils';
import { localeFromPath, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
---

<Layout title={t('plugins.title')} description={t('plugins.metaDescription', { n: plugins.length })}>
  {/* The page is a tool, so the header stays short: what this is, how
      fresh it is, then straight into the search. */}
  <div class="relative isolate">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-72 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_70%_100%_at_50%_0%,#000_30%,transparent_100%)]"
    >
    </div>

    <div class="mx-auto max-w-6xl px-4 pt-10 pb-16 sm:px-6 sm:pt-14">
      <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t('plugins.heading')}</h1>
          <p class="mt-3 text-base text-muted-foreground">{t('plugins.subtitle', { n: formatNumber(plugins.length) })}</p>
        </div>
        <span class="inline-flex items-center gap-2 self-start rounded-full border border-border bg-background/80 px-3 py-1 text-xs text-muted-foreground backdrop-blur sm:self-auto">
          <span class="size-1.5 rounded-full bg-ok" aria-hidden="true"></span>
          {t('plugins.updated', { date: formatDate(generatedAt, lang) })}
        </span>
      </header>

      <div class="mt-8">
        <PluginExplorer client:load docs={searchDocsFor(lang)} categories={categories} lang={lang} />
      </div>
    </div>
  </div>
</Layout>
