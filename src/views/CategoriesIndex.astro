---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { categories, byCategory, census, generatedAt, lampClass, categoryLabel, categoryDescription } from '../lib/plugins';
import { avatarUrl, compactNumber, formatNumber, letterAvatar } from '../lib/utils';
import { localeFromPath, localePath, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const href = (path: string) => localePath(lang, path);

// "This week" is measured from the snapshot, so a rebuild of old data
// doesn't drift.
const snapshot = Date.parse(generatedAt);
const isNew = (iso: string | null) => !!iso && snapshot - Date.parse(iso) < 7 * 864e5;

const cats = categories.map((c) => {
  const list = byCategory(c.id);
  const ok = list.filter((p) => p.healthLevel === 'ok').length;
  const warn = list.filter((p) => p.healthLevel === 'warn').length;
  return {
    ...c,
    top: list.slice(0, 3),
    ok,
    warn,
    danger: list.length - ok - warn,
    okPct: list.length ? Math.round((ok / list.length) * 100) : 0,
    fresh: list.filter((p) => isNew(p.createdAt)).length,
    stars: list.reduce((s, p) => s + p.stars, 0),
  };
});

// "Other" is a remainder, not an area: it never wins an insight, and always
// sits at the end of the grid.
const real = cats.filter((c) => c.id !== 'other');
const biggest = [...real].sort((a, b) => b.count - a.count)[0];
const fastest = [...real].sort((a, b) => b.fresh - a.fresh)[0];
// A category of nine plugins at 100% isn't "the healthiest area"; require
// some size before a ratio means anything.
const healthiest = [...real].filter((c) => c.count >= 20).sort((a, b) => b.okPct - a.okPct)[0];
const ordered = [...real].sort((a, b) => b.count - a.count).concat(cats.filter((c) => c.id === 'other'));

const insights = [
  { label: t('categories.biggest'), c: biggest, value: t('categories.countUnit', { n: formatNumber(biggest.count) }) },
  { label: t('categories.fastest'), c: fastest, value: t('categories.newWeekLong', { n: fastest.fresh }) },
  { label: t('categories.healthiest'), c: healthiest, value: t('categories.activePct', { n: healthiest.okPct }) },
];

const card = 'rounded-xl border border-border bg-card text-card-foreground shadow-xs';
---

<Layout title={t('categories.title')} description={t('categories.metaDescription')}>
  <PageHeader
    title={t('categories.heading')}
    description={t('categories.intro')}
    eyebrow={t('categories.eyebrow', { n: categories.length })}
  >
    <div slot="aside" class="grid gap-3 sm:grid-cols-3 lg:w-[34rem]">
      {
        insights.map((i) => (
          <a href={`#${i.c.id}`} class={`${card} group block p-4 transition-colors hover:bg-accent`}>
            <p class="text-xs text-muted-foreground">{i.label}</p>
            <p class="mt-2 flex items-center gap-2 font-semibold">
              <CategoryIcon name={i.c.icon} class="size-4 shrink-0 text-muted-foreground" />
              <span class="truncate">{categoryLabel(i.c.id, lang)}</span>
            </p>
            <p class="tabular mt-1 text-xs text-muted-foreground">{i.value}</p>
          </a>
        ))
      }
    </div>
  </PageHeader>

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="tabular text-sm text-muted-foreground">
        {t('explorer.total', { n: formatNumber(census.total) })}
      </p>
      {/* Reorders the grid in place; the server order is "most plugins". */}
      <div class="inline-flex h-9 items-center rounded-lg bg-muted p-[3px]" role="group" aria-label={t('categories.sortAria')} data-cat-sort>
        {
          (['count', 'health', 'growth'] as const).map((key, i) => (
            <button
              type="button"
              data-sort={key}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="h-full rounded-md px-3 text-sm font-medium text-muted-foreground transition-[color,box-shadow] hover:text-foreground aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-sm"
            >
              {t(`categories.sort.${key}`)}
            </button>
          ))
        }
      </div>
    </div>

    <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-cat-grid>
      {
        ordered.map((c) => (
          <li
            id={c.id}
            class="scroll-mt-24"
            data-count={c.count}
            data-health={c.id === 'other' ? -1 : c.okPct}
            data-growth={c.id === 'other' ? -1 : c.fresh}
          >
            <article class={`${card} spotlight group relative flex h-full flex-col overflow-hidden p-5 transition-[border-color,box-shadow,transform] hover:-translate-y-0.5 hover:border-foreground/20 hover:shadow-md motion-reduce:hover:translate-y-0`} data-spotlight>
              <div class="flex items-start justify-between gap-3">
                <div class="flex min-w-0 items-center gap-3">
                  <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-border bg-gradient-to-b from-background to-muted shadow-xs">
                    <CategoryIcon name={c.icon} class="size-5" />
                  </span>
                  <div class="min-w-0">
                    <h2 class="truncate font-semibold">
                      {/* Stretched link: the whole card opens the category. */}
                      <a href={href(`/categories/${c.id}`)} class="after:absolute after:inset-0">
                        {categoryLabel(c.id, lang)}
                      </a>
                    </h2>
                    {lang === 'zh' && <p class="truncate text-xs text-muted-foreground">{c.labelEn}</p>}
                  </div>
                </div>
                <div class="shrink-0 text-right">
                  <p class="tabular text-2xl leading-none font-semibold tracking-tight">{formatNumber(c.count)}</p>
                  {c.fresh > 0 && <p class="tabular mt-1 text-xs font-medium text-ok">{t('categories.newWeek', { n: c.fresh })}</p>}
                </div>
              </div>

              <p class="mt-3 line-clamp-2 min-h-10 text-sm leading-5 text-muted-foreground">{categoryDescription(c.id, lang)}</p>

              <div class="mt-4">
                <div class="flex items-center justify-between text-xs">
                  <span class="text-muted-foreground">{t('categories.healthSplit')}</span>
                  <span class="tabular font-medium text-ok">{t('categories.activePct', { n: c.okPct })}</span>
                </div>
                <div
                  class="mt-1.5 flex h-1.5 gap-px overflow-hidden rounded-full bg-muted"
                  role="img"
                  aria-label={t('categories.healthAria', { ok: c.ok, warn: c.warn, danger: c.danger })}
                >
                  <span class="block bg-ok" style={`width:${(c.ok / c.count) * 100}%`} />
                  <span class="block bg-warn" style={`width:${(c.warn / c.count) * 100}%`} />
                  <span class="block bg-danger" style={`width:${(c.danger / c.count) * 100}%`} />
                </div>
              </div>

              <ol class="relative z-10 mt-4 space-y-0.5 border-t border-border pt-3">
                {c.top.map((p) => (
                  <li>
                    <a href={href(`/plugins/${p.slug}`)} class="flex items-center gap-2.5 rounded-md px-1.5 py-1.5 transition-colors hover:bg-accent">
                      <span class="relative size-6 shrink-0">
                        <span class="block size-full overflow-hidden rounded-md border border-border bg-muted">
                          {p.ownerAvatar ? (
                            <img src={avatarUrl(p.ownerAvatar, 24)} alt="" width="24" height="24" loading="lazy" decoding="async" class="size-full object-cover" />
                          ) : (
                            <span class="grid size-full place-items-center text-[0.625rem] font-medium text-white" style={`background:${letterAvatar(p.title).color}`}>{letterAvatar(p.title).letter}</span>
                          )}
                        </span>
                        <span class:list={['lamp absolute -right-0.5 -bottom-0.5 scale-75 ring-2 ring-card', lampClass[p.healthLevel]]} aria-hidden="true" />
                      </span>
                      <span class="min-w-0 flex-1 truncate text-sm">{p.title}</span>
                      <span class="tabular shrink-0 text-xs text-muted-foreground">★ {compactNumber(p.stars)}</span>
                    </a>
                  </li>
                ))}
              </ol>

              <p class="mt-auto pt-3 text-sm font-medium text-muted-foreground transition-colors group-hover:text-foreground">
                {t('categories.viewAll', { n: formatNumber(c.count) })} <span aria-hidden="true">→</span>
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<style>
  /* A soft light follows the pointer across a card. */
  .spotlight::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
    background: radial-gradient(
      260px circle at var(--x, 50%) var(--y, 50%),
      color-mix(in oklch, var(--foreground) 6%, transparent),
      transparent 70%
    );
  }
  @media (hover: hover) and (pointer: fine) {
    .spotlight:hover::before {
      opacity: 1;
    }
  }
</style>

<script>
  // Sorting reorders with CSS `order`, so the DOM stays as rendered and
  // nothing is re-created. Delegated from `document`, so it works however
  // this script came to run (first load, soft navigation, a dev hot reload).
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-cat-sort] [data-sort]');
    const grid = document.querySelector<HTMLElement>('[data-cat-grid]');
    if (!btn || !grid) return;
    const key = btn.dataset.sort as 'count' | 'health' | 'growth';
    btn.parentElement?.querySelectorAll('[data-sort]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    [...grid.querySelectorAll<HTMLElement>('li[data-count]')]
      .sort((a, b) => Number(b.dataset[key]) - Number(a.dataset[key]) || Number(b.dataset.count) - Number(a.dataset.count))
      .forEach((el, i) => (el.style.order = String(i)));
  });

  document.addEventListener('pointermove', (event) => {
    const el = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-spotlight]');
    if (!el) return;
    const r = el.getBoundingClientRect();
    el.style.setProperty('--x', `${event.clientX - r.left}px`);
    el.style.setProperty('--y', `${event.clientY - r.top}px`);
  });
</script>
