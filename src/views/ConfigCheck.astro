---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ConfigChecker from '../components/ConfigChecker';
import { localeFromPath, localePath, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
---

<Layout title={t('config.title')} description={t('config.desc')}>
  <PageHeader
    title={t('config.title')}
    description={t('config.desc')}
    breadcrumb={[[t('plugin.home'), localePath(lang, '/')], [t('config.title')]]}
    breadcrumbLabel={t('plugin.breadcrumbAria')}
  >
    <p class="mt-3 text-xs text-muted-foreground">{t('config.privacy')}</p>
  </PageHeader>
  <div class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <ConfigChecker client:load lang={lang} />
  </div>
</Layout>
