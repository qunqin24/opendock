---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PluginExplorer, { PAGE_SIZE } from '../components/PluginExplorer';
import CategoryIcon from '../components/CategoryIcon.astro';
import { categories, searchDocsFor, byCategory, categoryLabel, categoryDescription, generatedAt, lampClass, type Category } from '../lib/plugins';
import { avatarUrl, compactNumber, formatNumber, letterAvatar } from '../lib/utils';
import { localeFromPath, localePath, useTranslations } from '../lib/i18n';

interface Props {
  category: Category;
}
const { category } = Astro.props;

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const href = (path: string) => localePath(lang, path);
const label = categoryLabel(category.id, lang);
const description = categoryDescription(category.id, lang);

// The explorer keeps its own category chips, so scope the dataset here and
// let it filter within the category rather than across everything.
const docs = searchDocsFor(lang).filter((d) => d.category === category.id);

// Same maintenance census the index page shows, so a category keeps its
// identity when you drill into it.
const list = byCategory(category.id);
const ok = list.filter((p) => p.healthLevel === 'ok').length;
const warn = list.filter((p) => p.healthLevel === 'warn').length;
const danger = list.length - ok - warn;
const stars = list.reduce((sum, p) => sum + p.stars, 0);
const pct = (n: number) => (category.count > 0 ? (n / category.count) * 100 : 0);
const snapshot = Date.parse(generatedAt);
const fresh = list.filter((p) => p.createdAt && snapshot - Date.parse(p.createdAt) < 7 * 864e5).length;
const leaders = list.slice(0, 3);

const siblings = categories.filter((c) => c.id !== category.id).sort((a, b) => b.count - a.count);

const site = Astro.site ?? new URL('https://www.opendock.net');
// Trailing slash to match the canonical URL — build.format is 'directory'.
const abs = (path: string) => new URL(`${localePath(lang, path).replace(/\/$/, '')}/`, site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('categories.breadcrumbHome'), item: abs('/') },
        { '@type': 'ListItem', position: 2, name: t('categories.breadcrumb'), item: abs('/categories') },
        { '@type': 'ListItem', position: 3, name: label },
      ],
    },
    {
      '@type': 'ItemList',
      name: label,
      description,
      numberOfItems: category.count,
      itemListElement: list.slice(0, 20).map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.title,
        url: abs(`/plugins/${p.slug}`),
      })),
    },
  ],
};

const card = 'rounded-xl border border-border bg-card text-card-foreground shadow-xs';
const medal = ['bg-amber-400/15 text-amber-700 dark:text-amber-300', 'bg-zinc-400/15 text-zinc-600 dark:text-zinc-300', 'bg-orange-700/10 text-orange-800 dark:text-orange-300'];
---

<Layout
  title={t('categories.detailTitle', { label })}
  description={t('categories.detailDescription', { description, count: category.count })}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <PageHeader
    title={label}
    description={description}
    breadcrumb={[[t('categories.breadcrumbHome'), href('/')], [t('categories.breadcrumb'), href('/categories')], [label]]}
    breadcrumbLabel={t('plugin.breadcrumbAria')}
  >
    <span slot="icon" class="mb-5 grid size-14 place-items-center rounded-2xl border border-border bg-gradient-to-b from-background to-muted shadow-sm">
      <CategoryIcon name={category.icon} class="size-7" />
    </span>
    {lang === 'zh' && <p class="mt-1 text-sm text-muted-foreground">{category.labelEn}</p>}

    <dl slot="aside" class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:w-[34rem]">
      <div class={`${card} p-4`}>
        <dt class="text-xs text-muted-foreground">{t('categories.statPlugins')}</dt>
        <dd class="tabular mt-1.5 text-xl font-semibold tracking-tight">{formatNumber(category.count)}</dd>
      </div>
      <div class={`${card} p-4`}>
        <dt class="text-xs text-muted-foreground">{t('categories.statStars')}</dt>
        <dd class="tabular mt-1.5 text-xl font-semibold tracking-tight">{compactNumber(stars)}</dd>
      </div>
      <div class={`${card} p-4`}>
        <dt class="text-xs text-muted-foreground">{t('categories.statActive')}</dt>
        <dd class="tabular mt-1.5 text-xl font-semibold tracking-tight">{Math.round(pct(ok))}%</dd>
        <dd
          class="mt-2 flex h-1.5 gap-px overflow-hidden rounded-full bg-muted"
          role="img"
          aria-label={t('categories.healthAria', { ok, warn, danger })}
        >
          <span class="block bg-ok" style={`width:${pct(ok)}%`}></span>
          <span class="block bg-warn" style={`width:${pct(warn)}%`}></span>
          <span class="block bg-danger" style={`width:${pct(danger)}%`}></span>
        </dd>
      </div>
      <div class={`${card} p-4`}>
        <dt class="text-xs text-muted-foreground">{t('categories.statNew')}</dt>
        <dd class:list={['tabular mt-1.5 text-xl font-semibold tracking-tight', fresh > 0 && 'text-ok']}>+{fresh}</dd>
      </div>
    </dl>
  </PageHeader>

  <div class="mx-auto max-w-6xl space-y-14 px-4 pb-16 sm:px-6">
    {/* ---- leaders ---- */}
    {
      leaders.length > 0 && (
        <section aria-labelledby="leaders-title">
          <h2 id="leaders-title" class="text-xl font-semibold tracking-tight">{t('categories.leaders')}</h2>
          <p class="mt-1 text-sm text-muted-foreground">{t('categories.leadersDesc')}</p>
          <ol class="mt-5 grid gap-4 md:grid-cols-3">
            {leaders.map((p, i) => (
              <li>
                <a
                  href={href(`/plugins/${p.slug}`)}
                  class={`${card} group flex h-full flex-col p-5 transition-[border-color,box-shadow,transform] hover:-translate-y-0.5 hover:border-foreground/20 hover:shadow-md motion-reduce:hover:translate-y-0`}
                >
                  <div class="flex items-start justify-between gap-3">
                    <span class="relative size-12 shrink-0">
                      <span class="block size-full overflow-hidden rounded-xl border border-border bg-muted">
                        {p.ownerAvatar ? (
                          <img src={avatarUrl(p.ownerAvatar, 48)} alt="" width="48" height="48" loading="lazy" decoding="async" class="size-full object-cover" />
                        ) : (
                          <span class="grid size-full place-items-center font-semibold text-white" style={`background:${letterAvatar(p.title).color}`}>{letterAvatar(p.title).letter}</span>
                        )}
                      </span>
                      <span class:list={['lamp absolute -right-0.5 -bottom-0.5 ring-2 ring-card', lampClass[p.healthLevel]]} aria-hidden="true" />
                    </span>
                    <span class:list={['tabular rounded-md px-2 py-0.5 text-xs font-semibold', medal[i]]}>#{i + 1}</span>
                  </div>
                  <h3 class="mt-4 truncate font-semibold">{p.title}</h3>
                  <p class="truncate font-mono text-xs text-muted-foreground">{p.name}</p>
                  <p class="mt-3 mb-5 line-clamp-2 min-h-10 text-sm leading-5 text-muted-foreground">{p.description ?? t('common.noDescription')}</p>
                  <dl class="tabular mt-auto grid grid-cols-3 gap-3 border-t border-border pt-4 text-xs">
                    <div>
                      <dt class="text-muted-foreground">{t('explorer.col.stars')}</dt>
                      <dd class="mt-0.5 text-sm font-semibold">{compactNumber(p.stars)}</dd>
                    </div>
                    <div>
                      <dt class="text-muted-foreground">{t('explorer.col.downloads')}</dt>
                      <dd class="mt-0.5 text-sm font-semibold">{compactNumber(p.downloadsMonth)}</dd>
                    </div>
                    <div>
                      <dt class="text-muted-foreground">{t('explorer.col.score')}</dt>
                      <dd class="mt-0.5 text-sm font-semibold">{p.score.toFixed(0)}</dd>
                    </div>
                  </dl>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {/* ---- every plugin ---- */}
    <section aria-labelledby="all-title">
      <h2 id="all-title" class="mb-5 text-xl font-semibold tracking-tight">{t('categories.allPlugins')}</h2>
      <PluginExplorer
        client:load
        docs={docs.slice(0, PAGE_SIZE)}
        total={docs.length}
        src={lang === 'zh' ? '/zh/plugins-index.json' : '/plugins-index.json'}
        scope={category.id}
        maxDownloads={Math.max(0, ...docs.map((d) => d.downloadsMonth))}
        categories={[]}
        lang={lang}
      />
    </section>

    {/* ---- other categories ---- */}
    <nav aria-labelledby="others-title">
      <h2 id="others-title" class="text-xl font-semibold tracking-tight">{t('categories.otherAreas')}</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          siblings.map((c) => (
            <li>
              <a
                href={href(`/categories/${c.id}`)}
                class={`${card} group flex items-center gap-3 p-3 transition-colors hover:bg-accent`}
              >
                <span class="grid size-9 shrink-0 place-items-center rounded-lg border border-border bg-gradient-to-b from-background to-muted">
                  <CategoryIcon name={c.icon} class="size-4" />
                </span>
                <span class="min-w-0 flex-1 truncate text-sm font-medium">{categoryLabel(c.id, lang)}</span>
                <span class="tabular shrink-0 text-xs text-muted-foreground">{formatNumber(c.count)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Layout>
