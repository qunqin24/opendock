---
/** The daily pipeline as four steps in order — a real sequence, so numbered. */
interface Props {
  steps: { title: string; detail: string }[];
}
const { steps } = Astro.props;
---

<ol class="not-prose my-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
  {
    steps.map((s, i) => (
      <li class="relative rounded-lg border border-border bg-muted/40 p-4">
        <span class="tabular grid size-6 place-items-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">{i + 1}</span>
        <p class="mt-3 text-sm font-medium">{s.title}</p>
        <p class="mt-1 text-xs leading-5 text-muted-foreground">{s.detail}</p>
        {i < steps.length - 1 && (
          <span class="absolute top-1/2 -right-2.5 z-10 hidden size-5 -translate-y-1/2 place-items-center rounded-full border border-border bg-background text-muted-foreground lg:grid" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3"><path d="m9 18 6-6-6-6" /></svg>
          </span>
        )}
      </li>
    ))
  }
</ol>
