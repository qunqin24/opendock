---
/** One card on the about page; its prose is styled by `.prose-about`. */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-20 rounded-xl border border-border bg-card p-6 text-card-foreground shadow-xs sm:p-8">
  <h2 id={`${id}-title`} class="text-xl font-semibold tracking-tight">{title}</h2>
  <div class="prose-about mt-4">
    <slot />
  </div>
</section>
