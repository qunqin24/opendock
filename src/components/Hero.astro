---
import { census, totals } from '../lib/plugins';
import { compactNumber, formatNumber, seededShuffle } from '../lib/utils';
import { localeFromPath, localePath, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const activeRate = Math.round((census.active / Math.max(census.total, 1)) * 100);

// --- Health-distribution grid ------------------------------------------
// A proportional sampling of the whole dock, coloured by real health
// proportions and shuffled with a fixed seed so the layout doesn't reshuffle
// on every render — it's a census, not confetti.
const CELLS = 180;
// Guard the divisor: an empty snapshot would otherwise produce NaN cell
// counts and Array(NaN) throws, taking the whole build down with it.
const sampled = Math.max(census.total, 1);
const okCells = Math.round((census.active / sampled) * CELLS);
const warnCells = Math.round((census.ailing / sampled) * CELLS);
const dangerCells = Math.max(CELLS - okCells - warnCells, 1);
const grid = seededShuffle(
  [
    ...Array(okCells).fill('ok'),
    ...Array(warnCells).fill('warn'),
    ...Array(dangerCells).fill('danger'),
  ] as const,
  1481,
);

const cellTone: Record<string, string> = {
  ok: 'bg-ok',
  warn: 'bg-warn',
  danger: 'bg-danger',
};

const quickTags = [
  { key: 'agents', href: '/categories/agents' },
  { key: 'mcp', href: '/categories/mcp' },
  { key: 'memory', href: '/categories/memory' },
  { key: 'lsp', href: '/categories/lsp' },
  { key: 'git', href: '/categories/git' },
  { key: 'trending', href: '/rankings#trending' },
] as const;
---

<section class="border-b border-border/80 pt-14 pb-16 sm:pt-20 sm:pb-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Hero Header: Headline & Subtitle -->
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-balance text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
        {t('home.hero.title.before')}<span class="font-mono">OpenCode</span>{t('home.hero.title.after')}
      </h1>

      <p class="mx-auto mt-4 max-w-xl text-balance text-base text-muted-foreground sm:leading-7">
        {t('home.hero.subtitle', { total: formatNumber(census.total) })}
      </p>

      <!-- Central Search Box -->
      <form action={localePath(lang, '/plugins')} method="get" class="relative mx-auto mt-8 max-w-xl">
        <div class="flex items-center rounded-lg border border-border bg-card p-1 transition-colors focus-within:border-foreground/50 hover:border-foreground/30">
          <div class="grid size-10 shrink-0 place-items-center text-muted-foreground">
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true">
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
            </svg>
          </div>

          <input
            type="search"
            name="q"
            data-plugin-search
            placeholder={t('home.hero.searchPlaceholder')}
            aria-label={t('explorer.searchAria')}
            class="min-w-0 flex-1 bg-transparent px-2 text-sm text-foreground placeholder:text-muted-foreground/70 focus:outline-none"
          />

          <div class="flex items-center gap-1.5 pr-1.5">
            <kbd class="hidden rounded-md border border-border bg-muted px-2 py-0.5 font-mono text-[0.6875rem] font-medium text-muted-foreground sm:inline-block">
              /
            </kbd>
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-md bg-foreground px-4 py-2 text-xs font-medium text-background transition-opacity hover:opacity-85"
            >
              {t('home.hero.search')}
            </button>
          </div>
        </div>
      </form>

      <!-- Quick Chips -->
      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-1 gap-y-2 text-xs">
        <span class="text-muted-foreground/80 mr-1 font-mono text-[0.6875rem]">{t('home.hero.popular')}</span>
        {
          quickTags.map((tag) => (
            <a
              href={localePath(lang, tag.href)}
              class="rounded-md px-2 py-1 text-xs text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
            >
              {t(`home.tag.${tag.key}` as const)}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Metrics & Health Distribution -->
    <div class="mt-14 grid gap-px overflow-hidden rounded-lg border border-border/80 bg-border/80 sm:grid-cols-2 lg:grid-cols-12">
      <!-- 4 Metric Cards (8 cols) -->
      <div class="grid grid-cols-2 gap-px bg-border/80 lg:col-span-8">
        <div class="bg-card p-5">
          <p class="text-xs text-muted-foreground">{t('home.metric.indexed')}</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="tabular font-mono text-3xl font-medium tracking-tight text-foreground">
              {formatNumber(census.total)}
            </span>
            <span class="rounded border border-border/70 px-1.5 py-0.5 font-mono text-[0.6875rem] text-muted-foreground">
              {t('home.metric.indexedTag')}
            </span>
          </div>
          <p class="mt-2 text-xs text-muted-foreground/80">
            {t('home.metric.indexedHint')}
          </p>
        </div>

        <div class="bg-card p-5">
          <p class="text-xs text-muted-foreground">{t('home.metric.stars')}</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="tabular font-mono text-3xl font-medium tracking-tight text-foreground">
              {compactNumber(totals.stars)}
            </span>
            <span class="inline-flex items-center text-amber-500">
              <svg viewBox="0 0 16 16" fill="currentColor" class="size-4" aria-hidden="true">
                <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
              </svg>
            </span>
          </div>
          <p class="mt-2 text-xs text-muted-foreground/80">
            {t('home.metric.starsHint')}
          </p>
        </div>

        <div class="bg-card p-5">
          <p class="text-xs text-muted-foreground">{t('home.metric.downloads')}</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="tabular font-mono text-3xl font-medium tracking-tight text-foreground">
              {compactNumber(totals.downloadsMonth)}
            </span>
            <span class="text-xs text-muted-foreground font-mono">
              /mo
            </span>
          </div>
          <p class="mt-2 text-xs text-muted-foreground/80">
            {t('home.metric.downloadsHint')}
          </p>
        </div>

        <div class="bg-card p-5">
          <p class="text-xs text-muted-foreground">{t('home.metric.active')}</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="tabular font-mono text-3xl font-medium tracking-tight text-ok">
              {activeRate}%
            </span>
            <span class="rounded border border-border/70 px-1.5 py-0.5 font-mono text-[0.6875rem] text-muted-foreground">
              ACTIVE
            </span>
          </div>
          <p class="mt-2 text-xs text-muted-foreground/80">
            {t('home.metric.activeHint', { n: formatNumber(census.active) })}
          </p>
        </div>
      </div>

      <!-- Health Distribution (4 cols) -->
      <div class="flex flex-col justify-between bg-card p-5 lg:col-span-4">
        <div>
          <div class="flex items-center justify-between">
            <p class="text-xs font-medium text-foreground">
              {t('home.pulse.title')}
            </p>
            <span class="tabular font-mono text-[0.6875rem] text-muted-foreground">
              {t('home.pulse.sample', { cells: CELLS, total: formatNumber(census.total) })}
            </span>
          </div>

          <!-- Sampling Dot Grid -->
          <div
            class="mt-3 rounded-md border border-border/60 bg-muted/40 p-2.5"
            role="img"
            aria-label={t('home.pulse.aria', { rate: activeRate })}
          >
            <div class="grid grid-cols-[repeat(15,minmax(0,1fr))] gap-[3px]">
              {grid.map((level) => (
                <span class={`aspect-square rounded-[2px] ${cellTone[level]}`} />
              ))}
            </div>
          </div>
        </div>

        <!-- Legend indicators -->
        <div class="mt-4 flex items-center justify-between border-t border-border/60 pt-3 text-[0.6875rem] font-mono text-muted-foreground">
          <span class="flex items-center gap-1.5">
            <span class="lamp lamp-ok" />
            {t('home.pulse.ok')} <strong class="tabular text-foreground">{census.active}</strong>
          </span>
          <span class="flex items-center gap-1.5">
            <span class="lamp lamp-warn" />
            {t('home.pulse.warn')} <strong class="tabular text-foreground">{census.ailing}</strong>
          </span>
          <span class="flex items-center gap-1.5">
            <span class="lamp lamp-danger" />
            {t('home.pulse.danger')} <strong class="tabular text-foreground">{census.abandoned}</strong>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
