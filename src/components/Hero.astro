---
import { census, totals } from '../lib/plugins';
import { compactNumber, formatNumber, seededShuffle } from '../lib/utils';

const activeRate = Math.round((census.active / Math.max(census.total, 1)) * 100);

// --- Health-distribution grid ------------------------------------------
// A proportional sampling of the whole dock, coloured by real health
// proportions and shuffled with a fixed seed so the layout doesn't reshuffle
// on every render — it's a census, not confetti.
const CELLS = 180;
// Guard the divisor: an empty snapshot would otherwise produce NaN cell
// counts and Array(NaN) throws, taking the whole build down with it.
const sampled = Math.max(census.total, 1);
const okCells = Math.round((census.active / sampled) * CELLS);
const warnCells = Math.round((census.ailing / sampled) * CELLS);
const dangerCells = Math.max(CELLS - okCells - warnCells, 1);
const grid = seededShuffle(
  [
    ...Array(okCells).fill('ok'),
    ...Array(warnCells).fill('warn'),
    ...Array(dangerCells).fill('danger'),
  ] as const,
  1481,
);

const cellTone: Record<string, string> = {
  ok: 'bg-ok',
  warn: 'bg-warn',
  danger: 'bg-danger',
};

const quickTags = [
  { label: '智能体编排', href: '/categories/agents' },
  { label: 'MCP 集成', href: '/categories/mcp' },
  { label: '记忆与上下文', href: '/categories/memory' },
  { label: '代码智能', href: '/categories/lsp' },
  { label: 'Git 工作流', href: '/categories/git' },
  { label: '本周飙升', href: '/rankings#trending' },
];
---

<section class="relative overflow-hidden border-b border-border/80 bg-gradient-to-b from-secondary/40 via-background to-background pt-12 pb-16 sm:pt-18 sm:pb-20">
  {/* Ambient background glow accents */}
  <div
    class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 size-[650px] rounded-full bg-gradient-to-tr from-dock/15 via-amber-500/10 to-transparent blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute -bottom-20 right-0 size-[400px] rounded-full bg-ok/5 blur-3xl"
    aria-hidden="true"
  />

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Hero Header: Headline & Subtitle -->
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-balance text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-6xl">
        探索 <span class="bg-gradient-to-r from-foreground via-foreground/90 to-muted-foreground bg-clip-text text-transparent">opencode</span> 插件生态全景
      </h1>

      <p class="mt-4 text-balance text-base text-muted-foreground sm:text-lg sm:leading-8">
        全量收录 <span class="font-semibold text-foreground">{formatNumber(census.total)}</span> 款生态插件，不仅看星标，更结合装机量、活跃度与状态灯实时点检，告别停更与已废弃插件。
      </p>

      <!-- Central Search Box -->
      <form action="/plugins" method="get" class="relative mx-auto mt-8 max-w-xl">
        <div class="group relative flex items-center rounded-2xl border-2 border-border bg-card p-1.5 shadow-lg shadow-foreground/[0.03] transition-all focus-within:border-foreground/80 focus-within:ring-4 focus-within:ring-foreground/5 hover:border-foreground/40">
          <div class="grid size-10 place-items-center text-muted-foreground">
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true">
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
            </svg>
          </div>

          <input
            type="search"
            name="q"
            data-plugin-search
            placeholder="搜索插件名、功能、关键词或作者 (按 / 聚焦)..."
            aria-label="搜索插件"
            class="min-w-0 flex-1 bg-transparent px-2 text-sm text-foreground placeholder:text-muted-foreground/70 focus:outline-none"
          />

          <div class="flex items-center gap-1.5 pr-2">
            <kbd class="hidden rounded-md border border-border bg-muted px-2 py-0.5 font-mono text-[0.6875rem] font-medium text-muted-foreground sm:inline-block">
              /
            </kbd>
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-xl bg-foreground px-4 py-2 text-xs font-semibold text-background transition-opacity hover:opacity-90 active:scale-95"
            >
              查找
            </button>
          </div>
        </div>
      </form>

      <!-- Quick Chips -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-1.5 text-xs">
        <span class="text-muted-foreground/80 mr-1 font-mono text-[0.6875rem]">热门探索:</span>
        {
          quickTags.map((tag) => (
            <a
              href={tag.href}
              class="rounded-full border border-border/80 bg-card/60 px-2.5 py-1 text-xs text-muted-foreground transition-all hover:border-foreground/40 hover:bg-secondary hover:text-foreground"
            >
              {tag.label}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Bento Metrics & Health Pulse Grid -->
    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-12">
      <!-- 4 Metric Cards (8 cols) -->
      <div class="grid grid-cols-2 gap-4 lg:col-span-8">
        <div class="rounded-2xl border border-border/80 bg-card p-5 transition-colors hover:border-border">
          <p class="text-xs font-medium text-muted-foreground">收录插件 (坞位)</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="tabular font-mono text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
              {formatNumber(census.total)}
            </span>
            <span class="rounded bg-dock/15 px-1.5 py-0.5 font-mono text-[0.6875rem] font-bold text-dock">
              全量
            </span>
          </div>
          <p class="mt-2 text-xs text-muted-foreground/80">
            自动抓取 npm 生态带标签包
          </p>
        </div>

        <div class="rounded-2xl border border-border/80 bg-card p-5 transition-colors hover:border-border">
          <p class="text-xs font-medium text-muted-foreground">累计 GitHub 星标</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="tabular font-mono text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
              {compactNumber(totals.stars)}
            </span>
            <span class="inline-flex items-center text-amber-500">
              <svg viewBox="0 0 16 16" fill="currentColor" class="size-4" aria-hidden="true">
                <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
              </svg>
            </span>
          </div>
          <p class="mt-2 text-xs text-muted-foreground/80">
            实时拉取仓库最新星标变化
          </p>
        </div>

        <div class="rounded-2xl border border-border/80 bg-card p-5 transition-colors hover:border-border">
          <p class="text-xs font-medium text-muted-foreground">月度装机量</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="tabular font-mono text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
              {compactNumber(totals.downloadsMonth)}
            </span>
            <span class="text-xs font-medium text-muted-foreground font-mono">
              /mo
            </span>
          </div>
          <p class="mt-2 text-xs text-muted-foreground/80">
            npm 近 30 天真实下载统计
          </p>
        </div>

        <div class="rounded-2xl border border-border/80 bg-card p-5 transition-colors hover:border-border">
          <p class="text-xs font-medium text-muted-foreground">健康活跃率</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="tabular font-mono text-3xl font-extrabold tracking-tight text-ok sm:text-4xl">
              {activeRate}%
            </span>
            <span class="rounded bg-ok-bg px-1.5 py-0.5 font-mono text-[0.6875rem] font-bold text-ok">
              ACTIVE
            </span>
          </div>
          <p class="mt-2 text-xs text-muted-foreground/80">
            {formatNumber(census.active)} 个项目近期持续维护
          </p>
        </div>
      </div>

      <!-- Health Distribution Pulse (4 cols) -->
      <div class="flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-5 lg:col-span-4">
        <div>
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold tracking-wide text-foreground uppercase">
              生态健康度矩阵
            </p>
            <span class="tabular font-mono text-xs text-muted-foreground">
              {CELLS} 样本 / {formatNumber(census.total)} 全量
            </span>
          </div>

          <!-- Sampling Dot Grid -->
          <div
            class="dock-sweep relative mt-3 overflow-hidden rounded-xl border border-border/60 bg-muted/40 p-2.5"
            role="img"
            aria-label={`健康度占比：${activeRate}% 活跃`}
          >
            <div class="grid grid-cols-[repeat(15,minmax(0,1fr))] gap-[3px]">
              {grid.map((level) => (
                <span class={`aspect-square rounded-[2px] transition-transform hover:scale-125 ${cellTone[level]}`} />
              ))}
            </div>
          </div>
        </div>

        <!-- Legend indicators -->
        <div class="mt-4 flex items-center justify-between border-t border-border/60 pt-3 text-[0.6875rem] font-mono text-muted-foreground">
          <span class="flex items-center gap-1.5">
            <span class="lamp lamp-ok" />
            活跃 <strong class="tabular text-foreground">{census.active}</strong>
          </span>
          <span class="flex items-center gap-1.5">
            <span class="lamp lamp-warn" />
            停更 <strong class="tabular text-foreground">{census.ailing}</strong>
          </span>
          <span class="flex items-center gap-1.5">
            <span class="lamp lamp-danger" />
            归档 <strong class="tabular text-foreground">{census.abandoned}</strong>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
