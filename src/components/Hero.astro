---
import BerthRow from './BerthRow.astro';
import { rankings, census, generatedAt } from '../lib/plugins';
import { formatNumber, seededShuffle } from '../lib/utils';

const berths = rankings.top.slice(0, 8);

const stamped = new Date(generatedAt);
const pad = (n: number) => String(n).padStart(2, '0');
const snapshot = `${stamped.getFullYear()}-${pad(stamped.getMonth() + 1)}-${pad(stamped.getDate())} ${pad(
  stamped.getHours(),
)}:${pad(stamped.getMinutes())}`;

// The census is the thesis: this dock knows which of its berths are alive.
const edition = [
  { label: '快照', value: snapshot },
  { label: '坞位', value: formatNumber(census.total) },
  { label: '活跃', value: formatNumber(census.active) },
  { label: '停摆', value: formatNumber(census.ailing + census.abandoned) },
];

// --- Health-distribution grid ------------------------------------------
// A proportional sampling of the whole dock, coloured by real health
// proportions and shuffled with a fixed seed so the layout doesn't
// reshuffle on every request in dev — it's a census, not confetti.
const CELLS = 280;
const okCells = Math.round((census.active / census.total) * CELLS);
const warnCells = Math.round((census.ailing / census.total) * CELLS);
const dangerCells = Math.max(CELLS - okCells - warnCells, 1);
const grid = seededShuffle(
  [
    ...Array(okCells).fill('ok'),
    ...Array(warnCells).fill('warn'),
    ...Array(dangerCells).fill('danger'),
  ] as const,
  1481,
);

const cellTone: Record<string, string> = {
  ok: 'bg-ok',
  warn: 'bg-warn',
  danger: 'bg-danger',
};

const legend = [
  { level: 'ok', label: '活跃', value: census.active },
  { level: 'warn', label: '停更', value: census.ailing },
  { level: 'danger', label: '归档', value: census.abandoned },
];
---

<section class="relative overflow-hidden border-b border-border">
  <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-16">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:items-end lg:gap-8">
      <!-- statement -->
      <div class="animate-in fade-in slide-in-from-bottom-2 duration-700">
        <p class="meta flex items-center gap-2 text-muted-foreground">
          <span class="size-1.5 shrink-0 rounded-full bg-dock"></span>
          港口普查 · 每日同步 npm &amp; github
        </p>

        <h1 class="display mt-4 text-[clamp(2.75rem,8.5vw,6rem)] leading-[0.92] text-foreground">
          停靠着
          <span class="tabular block text-foreground">{formatNumber(census.total)}</span>
        </h1>

        <p class="mt-4 max-w-[38ch] text-[0.9375rem] leading-6 text-muted-foreground">
          <span class="font-mono text-foreground/80">个 opencode 插件</span>
          ——不是精选列表，而是全量收录、逐日更新，并按健康度逐一点灯。
        </p>

        <!-- edition strip -->
        <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 border-t border-border pt-5">
          {
            edition.map((e) => (
              <div>
                <dt class="meta text-muted-foreground/80">{e.label}</dt>
                <dd class="tabular mt-1 font-mono text-lg text-foreground sm:text-xl">{e.value}</dd>
              </div>
            ))
          }
        </dl>

        <!-- scanner search -->
        <form action="/plugins" method="get" class="relative mt-8 max-w-lg">
          <span class="pointer-events-none absolute -top-1 -left-1 size-3 rounded-tl-lg border-t-2 border-l-2 border-dock"></span>
          <span class="pointer-events-none absolute -top-1 -right-1 size-3 rounded-tr-lg border-t-2 border-r-2 border-dock"></span>
          <span class="pointer-events-none absolute -bottom-1 -left-1 size-3 rounded-bl-lg border-b-2 border-l-2 border-dock"></span>
          <span class="pointer-events-none absolute -right-1 -bottom-1 size-3 rounded-br-lg border-r-2 border-b-2 border-dock"></span>

          <div class="flex items-center gap-3 rounded-lg border-2 border-foreground bg-background px-4 py-3">
            <span class="meta shrink-0 text-muted-foreground">查找</span>
            <input
              type="search"
              name="q"
              data-plugin-search
              placeholder="包名 / 功能 / 作者"
              aria-label="查找插件"
              class="min-w-0 flex-1 bg-transparent font-mono text-[0.9375rem] tracking-tight text-foreground placeholder:text-muted-foreground focus:outline-none [&::-webkit-search-cancel-button]:hidden"
            />
            <span class="dock-cursor h-4 w-px shrink-0 bg-foreground" aria-hidden="true"></span>
            <kbd class="shrink-0 rounded border border-border bg-muted px-1.5 py-px font-mono text-[0.625rem] text-muted-foreground">
              /
            </kbd>
          </div>
        </form>
      </div>

      <!-- health-distribution grid -->
      <div class="animate-in fade-in slide-in-from-bottom-2 duration-700 delay-150 fill-mode-both">
        <div class="dock-sweep relative overflow-hidden rounded-xl border border-border bg-card p-4">
          <p class="meta mb-3 flex items-center justify-between text-muted-foreground">
            <span>健康度分布</span>
            <span class="tabular text-foreground/70">{CELLS} / {formatNumber(census.total)}</span>
          </p>

          <div
            class="grid grid-cols-[repeat(16,minmax(0,1fr))] gap-[3px] sm:grid-cols-[repeat(20,minmax(0,1fr))]"
            role="img"
            aria-label={`按真实占比取样：约 ${Math.round((census.active / census.total) * 100)}% 活跃，其余停更或归档`}
          >
            {grid.map((level) => <span class={`aspect-square rounded-[1.5px] ${cellTone[level]}`} />)}
          </div>
        </div>

        <ul class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[0.6875rem] text-muted-foreground">
          {
            legend.map((l) => (
              <li class="flex items-center gap-1.5">
                <span class:list={['lamp', `lamp-${l.level}`]} />
                {l.label}
                <span class="tabular text-foreground">{formatNumber(l.value)}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- top berths -->
    <div class="mt-12">
      <p class="meta px-1 pb-2 text-muted-foreground">精选坞位 · TOP 08</p>

      <div
        class="meta grid grid-cols-[2.5rem_1fr_4.5rem] gap-4 border-t border-border px-1 pt-3 pb-2 text-muted-foreground sm:grid-cols-[3rem_1fr_6rem_5rem_4.25rem]"
      >
        <span>坞位</span>
        <span>插件</span>
        <span class="hidden sm:block">分类</span>
        <span class="text-right">星标</span>
        <span class="hidden text-right sm:block">月装机</span>
      </div>

      {berths.map((p, i) => <BerthRow plugin={p} berth={i + 1} />)}

      <div
        class="flex flex-wrap items-center justify-between gap-3 border-t border-border px-1 py-4 font-mono text-[0.6875rem] text-muted-foreground"
      >
        <span title="星标属于仓库。发布自 monorepo 的包会继承整个仓库的星标，这类数字不全额计入排名。">
          <span class="align-super text-[0.625rem]">*</span> 星标来自共享仓库
        </span>
        <a href="/plugins" class="text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground">
          查看全部 {formatNumber(census.total)} 个坞位 →
        </a>
      </div>
    </div>
  </div>
</section>
