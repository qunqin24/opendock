---
import { categoryIcons } from '../lib/icons';

interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'size-5' } = Astro.props;
const inner = categoryIcons[name] ?? categoryIcons.package;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={inner}
/>
