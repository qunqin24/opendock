---
import type { Plugin } from '../lib/plugins';
import { avatarUrl, compactNumber, timeAgo } from '../lib/utils';
import { localeFromPath, localePath, useTranslations } from '../lib/i18n';

interface Board {
  id: string;
  label: string;
  plugins: Plugin[];
  /** Which figure earns the right-hand column on this board. */
  metric: 'stars' | 'trending' | 'downloads' | 'recent' | 'top';
}

interface Props {
  boards: Board[];
}
const { boards } = Astro.props;
const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);

function metricOf(p: Plugin, metric: Board['metric']) {
  switch (metric) {
    case 'trending':
      return {
        label: t('board.metric.trending'),
        value: p.starsDelta7d > 0 ? `+${compactNumber(p.starsDelta7d)}` : '—',
        accent: p.starsDelta7d > 0,
      };
    case 'downloads':
      return {
        label: t('board.metric.downloads'),
        value: compactNumber(p.downloadsMonth),
        accent: false,
      };
    case 'recent':
      return {
        label: t('board.metric.recent'),
        value: timeAgo(p.createdAt, lang),
        accent: false,
      };
    case 'top':
      return {
        label: t('board.metric.top'),
        value: p.score.toFixed(0),
        accent: false,
      };
    default:
      return {
        label: t('board.metric.stars'),
        value: compactNumber(p.stars),
        accent: false,
      };
  }
}
---

<div class="overflow-hidden rounded-lg border border-border/80 bg-card" data-rankboard>
  {/* Tab headers */}
  <div class="flex flex-wrap items-center gap-1 border-b border-border/80 p-2" role="tablist">
    {
      boards.map((b, i) => (
        <button
          type="button"
          role="tab"
          data-tab={b.id}
          aria-selected={i === 0}
          class:list={[
            'rounded-md px-3 py-1.5 text-xs font-medium transition-colors',
            'aria-selected:bg-secondary aria-selected:text-foreground',
            'text-muted-foreground hover:text-foreground',
          ]}
        >
          {b.label}
        </button>
      ))
    }
  </div>

  {/* Tab panels */}
  {
    boards.map((b, i) => (
      <div data-panel={b.id} role="tabpanel" class:list={[i !== 0 && 'hidden']}>
        <div class="p-1.5">
          {b.plugins.map((p, idx) => {
            const m = metricOf(p, b.metric);
            return (
              <a
                href={localePath(lang, `/plugins/${p.slug}`)}
                class="group flex items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-secondary/60"
              >
                <span class="tabular w-5 shrink-0 text-right font-mono text-xs text-muted-foreground/70">
                  {idx + 1}
                </span>

                <span class="size-7 shrink-0 overflow-hidden rounded-md border border-border/80 bg-secondary">
                  {p.ownerAvatar ? (
                    <img
                      src={avatarUrl(p.ownerAvatar, 28)}
                      alt={p.owner ?? 'author'}
                      width="28"
                      height="28"
                      class="size-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="flex size-full items-center justify-center font-mono text-[0.625rem] text-foreground/70">
                      {(p.owner ?? p.name).charAt(0).toUpperCase()}
                    </span>
                  )}
                </span>

                <div class="flex min-w-0 flex-1 items-baseline gap-2">
                  <span class="shrink-0 truncate text-sm font-medium text-foreground">
                    {p.title}
                  </span>
                  <span class="hidden min-w-0 flex-1 truncate text-xs text-muted-foreground sm:inline">
                    {p.description ?? p.name}
                  </span>
                </div>

                <span class="shrink-0 text-right">
                  <span
                    class:list={[
                      'tabular font-mono text-sm',
                      m.accent ? 'text-ok' : 'text-foreground',
                    ]}
                  >
                    {m.value}
                  </span>
                  <span class="ml-1.5 text-[0.625rem] text-muted-foreground/70">{m.label}</span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    ))
  }
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-rankboard]').forEach((root) => {
      const tabs = root.querySelectorAll<HTMLButtonElement>('[data-tab]');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          root.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
            panel.classList.toggle('hidden', panel.dataset.panel !== tab.dataset.tab);
          });
        });
      });
    });
  });
</script>
