---
import type { Plugin } from '../lib/plugins';
import { lampClass, lampTitle } from '../lib/plugins';
import { compactNumber, timeAgo } from '../lib/utils';

interface Board {
  id: string;
  label: string;
  hint: string;
  plugins: Plugin[];
  /** Which figure earns the right-hand column on this board. */
  metric: 'stars' | 'trending' | 'downloads' | 'recent';
}

interface Props {
  boards: Board[];
}
const { boards } = Astro.props;

function metricOf(p: Plugin, metric: Board['metric']) {
  switch (metric) {
    case 'trending':
      return { value: p.starsDelta7d > 0 ? `+${compactNumber(p.starsDelta7d)}` : '—', accent: p.starsDelta7d > 0 };
    case 'downloads':
      return { value: compactNumber(p.downloadsMonth), accent: false };
    case 'recent':
      return { value: timeAgo(p.createdAt), accent: false };
    default:
      return { value: compactNumber(p.stars), accent: false };
  }
}
---

<div data-rankboard>
  <div class="flex flex-wrap gap-x-1 border-b border-border" role="tablist">
    {
      boards.map((b, i) => (
        <button
          type="button"
          role="tab"
          data-tab={b.id}
          aria-selected={i === 0}
          class:list={[
            'meta border-b-2 border-transparent px-1 pb-3 transition-colors',
            'aria-selected:border-dock aria-selected:text-foreground',
            'text-muted-foreground hover:text-foreground',
          ]}
        >
          <span class="tabular mr-1.5 text-muted-foreground/60">{String(i + 1).padStart(2, '0')}</span>
          {b.label}
        </button>
      ))
    }
  </div>

  {
    boards.map((b, i) => (
      <div data-panel={b.id} role="tabpanel" class:list={[i !== 0 && 'hidden']}>
        <p class="px-1 py-3.5 text-sm text-muted-foreground">{b.hint}</p>

        <ol>
          {b.plugins.map((p, idx) => {
            const m = metricOf(p, b.metric);
            return (
              <li>
                <a
                  href={`/plugins/${p.slug}`}
                  class="group relative grid grid-cols-[2rem_1fr_auto] items-center gap-4 border-t border-border/60 px-1 py-3 transition-[background-color,transform] duration-200 hover:translate-x-1 hover:bg-secondary/50"
                >
                  <span class="tabular font-mono text-[0.8125rem] text-muted-foreground/70">
                    {String(idx + 1).padStart(2, '0')}
                  </span>

                  <span class="min-w-0">
                    <span class="flex items-center gap-2.5">
                      <span class:list={['lamp', lampClass[p.healthLevel]]} title={lampTitle[p.healthLevel]} />
                      <span class="truncate text-sm font-medium tracking-tight group-hover:underline">
                        {p.title}
                      </span>
                    </span>
                    <span class="mt-0.5 block truncate text-xs text-muted-foreground">
                      {p.description ?? p.name}
                    </span>
                  </span>

                  <span
                    class:list={[
                      'tabular shrink-0 text-right font-mono text-[0.8125rem]',
                      m.accent ? 'text-ok' : 'text-foreground',
                    ]}
                  >
                    {m.value}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    ))
  }
</div>

<script>
  // Re-bound after every soft navigation — the module only executes once,
  // but returning to this page swaps in fresh tab elements.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-rankboard]').forEach((root) => {
      const tabs = root.querySelectorAll<HTMLButtonElement>('[data-tab]');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          root.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
            panel.classList.toggle('hidden', panel.dataset.panel !== tab.dataset.tab);
          });
        });
      });
    });
  });
</script>
