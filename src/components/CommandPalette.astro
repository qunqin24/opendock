---
import { categories, categoryLabel } from '../lib/plugins';
import { categoryIcons } from '../lib/icons';
import { localeFromPath, localePath, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);

/**
 * Header search. Deliberately not a framework island: this renders in the
 * header of every page, and mounting React here would put the whole client
 * runtime (~70 KB gzip) on pages that otherwise ship no JS at all. The shell
 * below is static markup — including the category group, which only needs
 * filtering — and the plugin rows are built in JS once Fuse and the search
 * index load on first open.
 */
const categoryLabels = Object.fromEntries(categories.map((c) => [c.id, categoryLabel(c.id, lang)]));
const sortedCategories = [...categories].sort((a, b) => (a.id === 'other' ? 1 : b.id === 'other' ? -1 : b.count - a.count));
---

<!-- Desktop trigger -->
<button
  type="button"
  data-cmdk-open
  class="hidden items-center gap-2 rounded-md border border-border bg-background px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-secondary sm:inline-flex"
  aria-label={t('explorer.searchAria')}
>
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" class="size-3.5" aria-hidden="true">
    <circle cx="7" cy="7" r="4.75"></circle>
    <path d="m10.5 10.5 3.5 3.5" stroke-linecap="round"></path>
  </svg>
  <span>{t('palette.open')}</span>
  <kbd
    data-cmdk-hint
    class="ml-3 rounded border border-border bg-muted px-1.5 py-px font-mono text-[0.625rem] text-muted-foreground"
    >/</kbd
  >
</button>

<!-- Phone trigger: the full bar doesn't fit, but search still should -->
<button
  type="button"
  data-cmdk-open
  class="grid size-9 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground sm:hidden"
  aria-label={t('explorer.searchAria')}
>
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4">
    <circle cx="7" cy="7" r="4.75"></circle>
    <path d="m10.5 10.5 3.5 3.5" stroke-linecap="round"></path>
  </svg>
</button>

<!--
  A native <dialog> opened with showModal(), not a fixed-position div: the
  header sets `backdrop-blur-xl`, and any non-none backdrop-filter makes an
  element the containing block for fixed descendants — an overlay here would
  be clamped to the 56px header instead of covering the page. The top layer
  ignores that, and we get focus trapping and inertness for free.
-->
<dialog
  data-cmdk-dialog
  data-categories={JSON.stringify(categoryLabels)}
  aria-label={t('explorer.searchAria')}
  class="m-0 h-full max-h-none w-full max-w-none border-0 bg-transparent p-0 backdrop:bg-transparent"
>
  <div data-cmdk-overlay class="h-full w-full overflow-y-auto bg-black/40 backdrop-blur-sm dark:bg-black/60">
    <div
      data-cmdk-panel
      class="mx-auto mt-[12vh] mb-8 flex max-h-[72vh] w-[calc(100%-2rem)] max-w-2xl flex-col overflow-hidden rounded-2xl border border-border bg-popover text-popover-foreground shadow-2xl ring-1 ring-black/5"
    >
      <div class="flex items-center gap-3 border-b border-border px-5">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5 shrink-0 text-muted-foreground" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          type="text"
          data-cmdk-input
          placeholder={t('palette.placeholder')}
          aria-label={t('explorer.searchAria')}
          autocomplete="off"
          spellcheck="false"
          class="h-14 min-w-0 flex-1 bg-transparent text-base text-foreground placeholder:text-muted-foreground focus:outline-none"
        />
        <button
          type="button"
          data-cmdk-close
          class="shrink-0 rounded-md border border-border bg-muted px-2 py-0.5 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground"
          >esc</button
        >
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto p-2" data-cmdk-scroll>
        <ul data-cmdk-list></ul>

        {/* Categories: static links, filtered by the query in JS. */}
        <div data-cmdk-cats-group>
          <p class="px-3 pt-3 pb-1.5 text-xs font-medium text-muted-foreground">{t('nav.categories')}</p>
          <ul class="grid grid-cols-1 gap-0.5 sm:grid-cols-2" data-cmdk-cats>
            {
              sortedCategories.map((c) => (
                <li data-label={`${categoryLabel(c.id, lang)} ${c.labelEn} ${c.label}`.toLowerCase()}>
                  <a
                    href={localePath(lang, `/categories/${c.id}`)}
                    data-cmdk-item
                    class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-colors hover:bg-accent/60"
                  >
                    <span class="grid size-7 shrink-0 place-items-center rounded-md border border-border bg-background text-muted-foreground">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-3.5"
                        aria-hidden="true"
                        set:html={categoryIcons[c.icon] ?? categoryIcons.package}
                      />
                    </span>
                    <span class="min-w-0 flex-1 truncate">{categoryLabel(c.id, lang)}</span>
                    <span class="tabular text-xs text-muted-foreground">{c.count}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <a
          data-cmdk-all
          data-cmdk-item
          href={localePath(lang, '/plugins')}
          class="mt-1 flex items-center justify-between rounded-lg px-3 py-2.5 text-sm text-muted-foreground transition-colors hover:bg-accent/60"
        >
          <span data-cmdk-all-label>{t('palette.browseAll')}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="flex items-center gap-4 border-t border-border bg-muted/40 px-5 py-2.5 text-xs text-muted-foreground">
        <span class="flex items-center gap-1.5">
          <kbd class="grid h-5 min-w-5 place-items-center rounded border border-border bg-background px-1 font-mono text-[0.6875rem]">↑</kbd>
          <kbd class="grid h-5 min-w-5 place-items-center rounded border border-border bg-background px-1 font-mono text-[0.6875rem]">↓</kbd>
          {t('palette.select').replace(/^[↑↓\s]+/, '')}
        </span>
        <span class="flex items-center gap-1.5">
          <kbd class="grid h-5 min-w-5 place-items-center rounded border border-border bg-background px-1 font-mono text-[0.6875rem]">↵</kbd>
          {t('palette.enter').replace(/^↵\s*/, '')}
        </span>
        <span class="hidden items-center gap-1.5 sm:flex">
          <kbd class="grid h-5 place-items-center rounded border border-border bg-background px-1 font-mono text-[0.6875rem]">esc</kbd>
          {t('palette.esc').replace(/^esc\s*/, '')}
        </span>
        <span data-cmdk-count class="tabular ml-auto"></span>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { navigate } from 'astro:transitions/client';
  import { avatarUrl, compactNumber, letterAvatar } from '../lib/utils';
  import { localeFromPath, localePath, useTranslations } from '../lib/i18n';

  // Resolved per call rather than once: this module survives soft navigation,
  // so the locale can change underneath it.
  const tr = () => useTranslations(localeFromPath(location.pathname));

  /** Mirrors the short keys in src/lib/search-index.ts. */
  interface Entry {
    s: string;
    t: string;
    n: string;
    d: string | null;
    o: string | null;
    a?: string | null;
    k: string[];
    c: string;
    r: number;
    h: 'ok' | 'warn' | 'danger';
  }

  const LIMIT = 8;
  const LAMP = { ok: 'lamp-ok', warn: 'lamp-warn', danger: 'lamp-danger' } as const;

  // DOM refs are rebound on every soft navigation; the downloaded index and
  // the built Fuse instance are module state, so they survive it and the
  // palette stays instant after the first search of the session.
  let dialog: HTMLDialogElement | null = null;
  let overlay: HTMLElement | null = null;
  let input: HTMLInputElement | null = null;
  let list: HTMLUListElement | null = null;
  let count: HTMLElement | null = null;
  let labels: Record<string, string> = {};

  let entries: Entry[] | null = null;
  let fuse: any = null;
  // The index is per-locale (descriptions differ), and this module outlives soft navigation.
  let indexLang: string | null = null;
  let loading = false;
  let failed = false;
  let results: Entry[] = [];
  let active = 0;
  let restore: HTMLElement | null = null;
  let globalsBound = false;

  /** Appends `text` to `el`, wrapping the first case-insensitive match of `q` in bold. */
  function highlight(el: HTMLElement, text: string, q: string) {
    const i = q ? text.toLowerCase().indexOf(q.toLowerCase()) : -1;
    if (i < 0) {
      el.textContent = text;
      return;
    }
    const mark = document.createElement('mark');
    mark.className = 'bg-transparent font-semibold text-foreground underline decoration-foreground/30 underline-offset-2';
    mark.textContent = text.slice(i, i + q.length);
    el.append(text.slice(0, i), mark, text.slice(i + q.length));
  }

  function init() {
    dialog = document.querySelector<HTMLDialogElement>('[data-cmdk-dialog]');
    overlay = document.querySelector<HTMLElement>('[data-cmdk-overlay]');
    input = document.querySelector<HTMLInputElement>('[data-cmdk-input]');
    list = document.querySelector<HTMLUListElement>('[data-cmdk-list]');
    count = document.querySelector<HTMLElement>('[data-cmdk-count]');
    if (!dialog || !overlay || !input || !list) return;

    labels = JSON.parse(dialog.dataset.categories ?? '{}');
    active = 0;
    results = [];

    const hint = document.querySelector('[data-cmdk-hint]');
    if (hint) hint.textContent = /Mac|iPhone|iPad/.test(navigator.platform) ? '⌘K' : 'Ctrl K';
    if (count && entries) count.textContent = tr()('palette.count', { n: entries.length });

    // Neither the index nor Fuse is worth downloading until someone searches.
    async function load() {
      const lang = localeFromPath(location.pathname);
      if ((fuse && indexLang === lang) || loading) return;
      loading = true;
      try {
        const [{ default: Fuse }, res] = await Promise.all([import('fuse.js'), fetch(lang === 'zh' ? '/zh/search-index.json' : '/search-index.json')]);
        const loaded = (await res.json()) as Entry[];
        entries = loaded;
        indexLang = lang;
        fuse = new Fuse(loaded, {
          keys: [
            { name: 't', weight: 3 },
            { name: 'n', weight: 3 },
            { name: 'd', weight: 2 },
            { name: 'k', weight: 1.5 },
            { name: 'o', weight: 1 },
          ],
          threshold: 0.35,
          ignoreLocation: true,
          minMatchCharLength: 2,
          includeScore: true,
        });
        if (count) count.textContent = tr()('palette.count', { n: entries.length });
      } catch {
        failed = true;
      } finally {
        loading = false;
        render();
      }
    }

    function search(): Entry[] {
      const q = input!.value.trim();
      if (!entries) return [];
      // No query yet: show the biggest plugins rather than an empty box.
      if (!q) return entries.slice().sort((a, b) => b.r - a.r).slice(0, 6);
      // Fuse alone orders near-identical names arbitrarily, so nudge by
      // popularity — log-scaled and capped small, so it only breaks ties
      // rather than letting a big repo outrank an exact name match.
      return fuse
        .search(q, { limit: LIMIT * 4 })
        .map((r: any) => ({ item: r.item, rank: (r.score ?? 1) - Math.min(Math.log10(r.item.r + 1) / 6, 0.08) }))
        .sort((a: any, b: any) => a.rank - b.rank)
        .slice(0, LIMIT)
        .map((r: any) => r.item);
    }

    function seeAllHref() {
      const q = input!.value.trim();
      const lang = localeFromPath(location.pathname);
      return localePath(lang, q ? `/plugins?q=${encodeURIComponent(q)}` : '/plugins');
    }

    /** Every row the arrow keys move through, in visual order. */
    const items = () => [...dialog!.querySelectorAll<HTMLAnchorElement>('[data-cmdk-item]')].filter((a) => a.offsetParent !== null);

    /** Rows are built with DOM APIs, never innerHTML — descriptions are npm text. */
    function render() {
      list!.replaceChildren();
      const q = input!.value.trim();
      const t = tr();

      // Categories: show the ones whose name matches, or all of them before
      // anything is typed.
      const lower = q.toLowerCase();
      let catMatches = 0;
      dialog!.querySelectorAll<HTMLElement>('[data-cmdk-cats] > li').forEach((li) => {
        const show = !q || (li.dataset.label ?? '').includes(lower);
        li.hidden = !show;
        if (show) catMatches++;
      });
      dialog!.querySelector<HTMLElement>('[data-cmdk-cats-group]')!.hidden = catMatches === 0;

      const all = dialog!.querySelector<HTMLAnchorElement>('[data-cmdk-all]')!;
      all.href = seeAllHref();
      all.querySelector('[data-cmdk-all-label]')!.textContent = q ? t('palette.searchAll', { q }) : t('palette.browseAll');

      if (loading && !entries) {
        list!.append(message(t('palette.loading')));
        return paint();
      }
      if (failed) {
        list!.append(message(t('palette.failed')));
        return paint();
      }

      results = search();
      if (results.length) {
        const h = document.createElement('li');
        h.className = 'px-3 pt-2 pb-1.5 text-xs font-medium text-muted-foreground';
        h.textContent = q ? `${t('nav.plugins')} · ${results.length}` : t('palette.popular');
        list!.append(h);
      }

      results.forEach((p) => {
        const a = document.createElement('a');
        a.href = localePath(localeFromPath(location.pathname), `/plugins/${p.s}`);
        a.dataset.cmdkItem = '';
        a.className = 'group flex items-center gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-accent/60';

        // Avatar (or a lettered tile) with the maintenance lamp.
        const av = document.createElement('span');
        av.className = 'relative size-9 shrink-0';
        const tile = document.createElement('span');
        tile.className = 'block size-full overflow-hidden rounded-lg border border-border bg-muted';
        if (p.a) {
          const img = document.createElement('img');
          img.src = avatarUrl(p.a.startsWith('http') ? p.a : `https://avatars.githubusercontent.com/${p.a}`, 36);
          img.alt = '';
          img.width = 36;
          img.height = 36;
          img.loading = 'lazy';
          img.className = 'size-full object-cover';
          tile.append(img);
        } else {
          const { letter, color } = letterAvatar(p.t);
          tile.className += ' grid place-items-center text-xs font-medium text-white';
          tile.style.background = color;
          tile.textContent = letter;
        }
        const lamp = document.createElement('span');
        lamp.className = `lamp absolute -right-0.5 -bottom-0.5 ring-2 ring-popover ${LAMP[p.h] ?? 'lamp-warn'}`;
        lamp.title = t(`health.tip.${p.h}` as const);
        av.append(tile, lamp);

        const mid = document.createElement('span');
        mid.className = 'min-w-0 flex-1';
        const title = document.createElement('span');
        title.className = 'block truncate text-sm font-medium';
        highlight(title, p.t, q);
        const meta = document.createElement('span');
        meta.className = 'mt-0.5 block truncate text-xs text-muted-foreground';
        meta.textContent = [labels[p.c], p.d ?? p.n].filter(Boolean).join(' · ');
        mid.append(title, meta);

        const right = document.createElement('span');
        right.className = 'flex shrink-0 items-center gap-2';
        if (p.r > 0) {
          const stars = document.createElement('span');
          stars.className = 'tabular text-xs text-muted-foreground';
          stars.textContent = `★ ${compactNumber(p.r)}`;
          right.append(stars);
        }
        const enter = document.createElement('kbd');
        enter.className =
          'hidden h-5 min-w-5 place-items-center rounded border border-border bg-background px-1 font-mono text-[0.6875rem] text-muted-foreground group-data-[active]:grid';
        enter.textContent = '↵';
        right.append(enter);

        a.append(av, mid, right);
        const li = document.createElement('li');
        li.append(a);
        list!.append(li);
      });

      if (q && !results.length && !catMatches) list!.append(message(t('explorer.emptyTitle')));
      active = 0;
      paint();
    }

    function message(text: string) {
      const li = document.createElement('li');
      li.className = 'px-4 py-10 text-center text-sm text-muted-foreground';
      li.textContent = text;
      return li;
    }

    /** Moving the highlight shouldn't rebuild every row. */
    function paint() {
      const rows = items();
      if (active >= rows.length) active = Math.max(0, rows.length - 1);
      rows.forEach((a, i) => {
        a.classList.toggle('bg-accent', i === active);
        a.toggleAttribute('data-active', i === active);
      });
      rows[active]?.scrollIntoView({ block: 'nearest' });
    }

    function open() {
      if (dialog!.open) return;
      restore = document.activeElement as HTMLElement | null;
      dialog!.showModal();
      document.body.style.overflow = 'hidden';
      input!.value = '';
      active = 0;
      render();
      input!.focus();
      void load();
    }

    function close() {
      if (dialog!.open) dialog!.close();
    }

    // Fires for our close() and for the browser's own Esc handling alike.
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      restore?.focus();
    });

    document.querySelectorAll('[data-cmdk-open]').forEach((b) => {
      b.addEventListener('click', open);
      b.addEventListener('mouseenter', () => void load());
    });
    document.querySelector('[data-cmdk-close]')?.addEventListener('click', close);
    overlay.addEventListener('mousedown', (e) => e.target === overlay && close());

    // Hovering a row moves the highlight there, so mouse and keys agree.
    dialog.addEventListener('mousemove', (e) => {
      const row = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>('[data-cmdk-item]');
      if (!row) return;
      const i = items().indexOf(row);
      if (i >= 0 && i !== active) {
        active = i;
        paint();
      }
    });

    // Following a link closes the palette so it doesn't linger mid-swap.
    dialog.addEventListener('click', (e) => {
      if ((e.target as HTMLElement | null)?.closest('[data-cmdk-item]')) close();
    });

    input.addEventListener('input', render);

    input.addEventListener('keydown', (e) => {
      const rows = items();
      if (!rows.length) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        active = (active + 1) % rows.length;
        paint();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        active = (active - 1 + rows.length) % rows.length;
        paint();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const href = rows[active]?.getAttribute('href');
        close();
        if (href) navigate(href);
      }
    });

    // `document` outlives every swap, so these must only ever bind once.
    if (!globalsBound) {
      globalsBound = true;

      // ⌘K/Ctrl-K opens from anywhere; `/` defers to a page that has its own
      // search field so the inline one keeps working.
      document.addEventListener('keydown', (e) => {
        if (!dialog) return;
        const el = document.activeElement;
        const typing = el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement;

        if (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          dialog.open ? close() : open();
        } else if (e.key === '/' && !e.metaKey && !e.ctrlKey && !typing && !dialog.open) {
          const inline = document.querySelector<HTMLInputElement>('[data-plugin-search]');
          e.preventDefault();
          if (inline) inline.focus();
          else open();
        }
      });

      // A top-layer dialog would otherwise linger over the incoming page.
      document.addEventListener('astro:before-swap', () => {
        if (dialog?.open) dialog.close();
        document.body.style.overflow = '';
      });
    }
  }

  // Fires on the initial load and after every soft navigation.
  document.addEventListener('astro:page-load', init);
</script>
