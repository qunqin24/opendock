---
import Logo from './Logo.astro';
import { generatedAt, totals, plugins } from '../lib/plugins';
import { formatNumber } from '../lib/utils';
import { localeFromPath, localePath, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const updated = new Date(generatedAt);
const stamp = `${updated.getFullYear()}-${String(updated.getMonth() + 1).padStart(2, '0')}-${String(
  updated.getDate(),
).padStart(2, '0')} ${String(updated.getHours()).padStart(2, '0')}:${String(updated.getMinutes()).padStart(2, '0')}`;

const columns = [
  {
    title: t('footer.browse'),
    links: [
      { href: localePath(lang, '/plugins'), label: t('footer.allPlugins') },
      { href: localePath(lang, '/categories'), label: t('footer.byCategory') },
      { href: localePath(lang, '/rankings'), label: t('footer.rankings') },
    ],
  },
  {
    title: 'OpenCode',
    links: [
      { href: 'https://opencode.ai', label: t('footer.official') },
      { href: 'https://opencode.ai/docs/plugins/', label: t('footer.pluginDocs') },
      { href: 'https://github.com/opencode-ai/opencode', label: t('footer.repo') },
    ],
  },
  {
    title: t('footer.about'),
    links: [
      { href: localePath(lang, '/submit'), label: t('footer.submit') },
      { href: localePath(lang, '/about'), label: t('footer.algorithm') },
    ],
  },
];
---

<footer class="mt-24 border-t border-border">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <Logo />
        <p class="mt-3 max-w-xs text-sm leading-6 text-muted-foreground">
          {t('footer.tagline')}
        </p>
        <p class="tabular mt-4 text-xs text-muted-foreground">
          {t('footer.stats', { plugins: formatNumber(plugins.length), stars: formatNumber(totals.stars) })}
        </p>
      </div>

      {
        columns.map((col) => (
          <div>
            <h3 class="text-xs font-semibold tracking-wide text-foreground uppercase">{col.title}</h3>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.href.startsWith('http') ? '_blank' : undefined}
                    rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
    >
      <p>{t('footer.disclaimer', { year: new Date().getFullYear() })}</p>
      <p class="tabular">{t('footer.updated', { stamp })}</p>
    </div>
  </div>
</footer>
