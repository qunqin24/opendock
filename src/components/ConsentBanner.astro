---
import { localeFromPath, localePath, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
---

{/*
  Hidden until the inline script decides there is no stored choice, so a
  returning visitor never sees it flash. The analytics scripts are injected
  by that same script and only after "allow" — nothing third-party loads
  while this banner is still on screen.
*/}
<div
  id="consent"
  hidden
  role="dialog"
  aria-modal="false"
  aria-labelledby="consent-title"
  class="fixed right-4 bottom-4 left-4 z-[70] mx-auto max-w-sm rounded-2xl border border-border bg-card p-4 shadow-lg sm:left-auto"
>
  <p id="consent-title" class="text-sm font-semibold text-foreground">{t('consent.title')}</p>
  <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">{t('consent.body')}</p>

  <div class="mt-3.5 flex items-center gap-2">
    <button
      type="button"
      data-consent="granted"
      class="rounded-lg bg-foreground px-3 py-1.5 text-xs font-semibold text-background transition-opacity hover:opacity-90"
    >
      {t('consent.accept')}
    </button>
    <button
      type="button"
      data-consent="denied"
      class="rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-medium text-foreground transition-colors hover:bg-secondary"
    >
      {t('consent.decline')}
    </button>
    <a
      href={localePath(lang, '/about')}
      class="ml-auto text-xs text-muted-foreground underline decoration-border underline-offset-4 transition-colors hover:text-foreground"
    >
      {t('consent.more')}
    </a>
  </div>
</div>

<script is:inline>
  (() => {
    const KEY = 'opendock:analytics';
    const SITE = 'a6924da9-0ce0-4394-9ed9-7739110b704b';

    // Injected only on consent. Both scripts are self-hosted Umami; the
    // recorder samples 15% of sessions with moderate masking.
    const load = () => {
      if (document.getElementById('umami-analytics')) return;
      const base = document.createElement('script');
      base.id = 'umami-analytics';
      base.defer = true;
      base.src = 'https://umami.qunqin.org/script.js';
      base.setAttribute('data-website-id', SITE);
      document.head.appendChild(base);

      const rec = document.createElement('script');
      rec.defer = true;
      rec.src = 'https://umami.qunqin.org/recorder.js';
      rec.setAttribute('data-website-id', SITE);
      rec.setAttribute('data-sample-rate', '0.15');
      rec.setAttribute('data-mask-level', 'moderate');
      rec.setAttribute('data-max-duration', '300000');
      document.head.appendChild(rec);
    };

    const decide = (value) => {
      try {
        localStorage.setItem(KEY, value);
      } catch {
        /* private mode — the choice just won't be remembered */
      }
      document.getElementById('consent')?.setAttribute('hidden', '');
      if (value === 'granted') load();
    };

    let stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch {
      /* ignore */
    }

    if (stored === 'granted') {
      load();
    } else if (stored !== 'denied') {
      // Bind on every swap: the banner element is replaced by the router.
      const arm = () => {
        const box = document.getElementById('consent');
        if (!box) return;
        try {
          if (localStorage.getItem(KEY)) return;
        } catch {
          /* ignore */
        }
        box.removeAttribute('hidden');
        box.querySelectorAll('[data-consent]').forEach((btn) => {
          btn.addEventListener('click', () => decide(btn.getAttribute('data-consent')));
        });
      };
      document.addEventListener('astro:page-load', arm);
      if (document.readyState !== 'loading') arm();
      else document.addEventListener('DOMContentLoaded', arm);
    }
  })();
</script>
