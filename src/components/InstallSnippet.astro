---
import type { Plugin } from '../lib/plugins';
import { localeFromPath, useTranslations } from '../lib/i18n';

interface Props {
  plugin: Plugin;
}
const { plugin: p } = Astro.props;
const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const spec = p.version ? `${p.name}@${p.version}` : p.name;
const config = `{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["${spec}"]
}`;

const tabs = [
  { id: 'project', label: t('install.project'), hint: t('install.projectHint'), file: 'opencode.json', code: config },
  {
    id: 'global',
    label: t('install.global'),
    hint: t('install.globalHint'),
    file: '~/.config/opencode/opencode.json',
    code: config,
  },
  { id: 'npm', label: t('install.manual'), hint: t('install.manualHint'), file: 'shell', code: `pnpm add -D ${p.name}` },
];
---

<div data-install>
  {/* shadcn/ui Tabs */}
  <div role="tablist" class="grid h-9 grid-cols-3 items-center rounded-lg bg-muted p-[3px] text-muted-foreground">
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          data-install-tab={tab.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="h-full rounded-md text-sm font-medium transition-[color,box-shadow] hover:text-foreground aria-selected:bg-background aria-selected:text-foreground aria-selected:shadow-sm"
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  {
    tabs.map((tab, i) => (
      <div data-install-panel={tab.id} role="tabpanel" class:list={['mt-3', i !== 0 && 'hidden']}>
        <div class="overflow-hidden rounded-lg border border-border">
          <div class="flex items-center justify-between gap-3 border-b border-border bg-muted/50 py-1.5 pr-1.5 pl-3">
            <span class="truncate font-mono text-xs text-muted-foreground">{tab.file}</span>
            <button
              type="button"
              data-copy={tab.code}
              class="inline-flex h-7 shrink-0 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-muted-foreground transition-colors hover:bg-background hover:text-foreground"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
                <rect width="14" height="14" x="8" y="8" rx="2" />
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
              </svg>
              <span data-copy-label>{t('plugin.copy')}</span>
            </button>
          </div>
          {/* Wraps instead of scrolling in the narrow sidebar; the copy button
            still copies the exact text. */}
          <pre class="px-3 py-3 font-mono text-xs leading-5 whitespace-pre-wrap [overflow-wrap:anywhere]"><code>{tab.code}</code></pre>
        </div>
        <p class="mt-2.5 text-xs leading-5 text-muted-foreground">{tab.hint}</p>
      </div>
    ))
  }
</div>

<script>
  // Delegated from `document`, so the tabs work however this script came to
  // run (first load, soft navigation, or a dev hot reload).
  document.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-install-tab]');
    const root = tab?.closest<HTMLElement>('[data-install]');
    if (!tab || !root) return;
    root.querySelectorAll('[data-install-tab]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    root.querySelectorAll<HTMLElement>('[data-install-panel]').forEach((panel) => {
      panel.classList.toggle('hidden', panel.dataset.installPanel !== tab.dataset.installTab);
    });
  });
</script>
