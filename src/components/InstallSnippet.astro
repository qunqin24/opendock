---
import type { Plugin } from '../lib/plugins';
import { localeFromPath, useTranslations } from '../lib/i18n';

interface Props {
  plugin: Plugin;
}
const { plugin: p } = Astro.props;
const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const spec = p.version ? `${p.name}@${p.version}` : p.name;

const tabs = [
  {
    id: 'project',
    label: t('install.project'),
    hint: t('install.projectHint'),
    file: 'opencode.json',
    code: `{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["${spec}"]
}`,
  },
  {
    id: 'global',
    label: t('install.global'),
    hint: t('install.globalHint'),
    file: '~/.config/opencode/opencode.json',
    code: `{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["${spec}"]
}`,
  },
  {
    id: 'npm',
    label: t('install.manual'),
    hint: t('install.manualHint'),
    file: 'shell',
    code: `pnpm add -D ${p.name}`,
  },
];
---

<div
  class="overflow-hidden rounded-lg border border-border bg-card"
  data-install
>
  <!-- The tab strip's fill already separates it from the panel; a rule on
       top of that is redundant structure. -->
  <div class="flex items-center gap-1 bg-secondary/50 px-2 py-1.5">
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          data-install-tab={tab.id}
          aria-selected={i === 0}
          class:list={[
            'rounded-md px-3 py-1 text-xs font-medium transition-colors',
            'aria-selected:bg-card aria-selected:text-foreground',
            'text-muted-foreground hover:text-foreground',
          ]}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  {
    tabs.map((tab, i) => (
      <div data-install-panel={tab.id} class:list={[i !== 0 && 'hidden']}>
        {/* Hint, filename and copy button share one row instead of stacking
            three separately-ruled bands inside the card. */}
        <div class="px-4 pt-3.5">
          <div class="flex items-start justify-between gap-3">
            <p class="text-xs leading-5 text-muted-foreground">{tab.hint}</p>
            <button
              type="button"
              data-copy={tab.code}
              class="-mt-1 inline-flex shrink-0 items-center gap-1.5 rounded-md px-2 py-1 text-xs text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
            >
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5">
                <rect x="5.75" y="5.75" width="8.5" height="8.5" rx="1.5" />
                <path d="M10.25 3.75v-1a1.5 1.5 0 0 0-1.5-1.5h-5.5a1.5 1.5 0 0 0-1.5 1.5v5.5a1.5 1.5 0 0 0 1.5 1.5h1" />
              </svg>
              <span data-copy-label>{t('plugin.copy')}</span>
            </button>
          </div>
        </div>

        {/* The code sits in a filled well rather than between two rules. */}
        <div class="px-4 pt-3 pb-4">
          <div class="rounded-md bg-muted px-3.5 py-3">
            <p class="mb-2 font-mono text-[0.625rem] text-muted-foreground">{tab.file}</p>
            <pre class="overflow-x-auto font-mono text-[0.8125rem] leading-6"><code>{tab.code}</code></pre>
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  // Re-bound after every soft navigation: the module itself only executes
  // once, but ClientRouter swaps in a fresh set of elements each time.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-install]').forEach((root) => {
      const tabs = root.querySelectorAll<HTMLButtonElement>('[data-install-tab]');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          root.querySelectorAll<HTMLElement>('[data-install-panel]').forEach((panel) => {
            panel.classList.toggle('hidden', panel.dataset.installPanel !== tab.dataset.installTab);
          });
        });
      });
    });
  });
</script>
