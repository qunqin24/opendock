---
import { hasDesktopUi, isTuiOnly, type Plugin } from '../lib/plugins';
import { localeFromPath, useTranslations } from '../lib/i18n';

interface Props {
  plugin: Plugin;
}
const { plugin: p } = Astro.props;
const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);

/*
 * Where a plugin goes depends on the OpenCode major and on which hosts load it
 * (`surfaces`, see scripts/lib/compat.mjs):
 *
 *   V1  server → opencode.json   "plugin"     TUI only → tui.json  "plugin"
 *   V2  server → opencode.json   "plugins"    TUI only → cli.json  "plugins"
 *
 * cli.json is global only. V2 also has `opencode plugin add` (installs into the
 * global config), and OpenCode Desktop loads the GUI parts of the plugins in
 * the global opencode.json only. Source: opencode.ai/docs/plugins,
 * /docs/build/plugins, /docs/cli/plugins and the V1 migration guide. Plugins that support V2, or don't say, get
 * the V2 form with a note for V1; V1-only plugins keep the V1 form.
 */
const spec = p.version ? `${p.name}@${p.version}` : p.name;
const v1Only = p.opencode === 'v1';
const tuiOnly = isTuiOnly(p);
const desktop = hasDesktopUi(p);

const json = (schema: string | null, key: string) =>
  schema ? `{\n  "$schema": "${schema}",\n  "${key}": ["${spec}"]\n}` : `{\n  "${key}": ["${spec}"]\n}`;
const source = { id: 'npm', label: t('install.manual'), hint: t('install.manualHint'), file: 'shell', code: `pnpm add -D ${p.name}` };

type Tab = { id: string; label: string; hint: string; file: string; code: string };
let tabs: Tab[];
let note: string | null = null;

if (v1Only) {
  const code = json(`https://opencode.ai/${tuiOnly ? 'tui' : 'config'}.json`, 'plugin');
  const project = tuiOnly ? '.opencode/tui.json' : 'opencode.json';
  const global = `~/.config/opencode/${tuiOnly ? 'tui' : 'opencode'}.json`;
  tabs = [
    { id: 'project', label: t('install.project'), hint: t('install.projectHint', { file: project }), file: project, code },
    { id: 'global', label: t('install.global'), hint: t('install.globalHint', { file: global }), file: global, code },
    source,
  ];
} else if (tuiOnly) {
  tabs = [
    { id: 'cli', label: t('install.command'), hint: t('install.commandHint'), file: 'shell', code: `opencode plugin add ${p.name}` },
    { id: 'global', label: t('install.global'), hint: t('install.tuiOnlyHint'), file: '~/.config/opencode/cli.json', code: json('https://opencode.ai/v2/cli.json', 'plugins') },
    source,
  ];
  if (p.opencode !== 'v2') note = t('install.v1NoteTui');
} else {
  const code = json('https://opencode.ai/config.json', 'plugins');
  tabs = [
    { id: 'cli', label: t('install.command'), hint: t('install.commandHint'), file: 'shell', code: `opencode plugin add ${p.name}` },
    { id: 'project', label: t('install.project'), hint: t('install.projectHint', { file: 'opencode.json' }), file: 'opencode.json', code },
    { id: 'global', label: t('install.global'), hint: t('install.globalHint', { file: '~/.config/opencode/opencode.json' }), file: '~/.config/opencode/opencode.json', code },
  ];
  if (p.opencode !== 'v2') note = t('install.v1Note');
}
---

<div data-install>
  {/* shadcn/ui Tabs */}
  <div role="tablist" class="grid h-9 grid-cols-3 items-center rounded-lg bg-muted p-[3px] text-muted-foreground">
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          data-install-tab={tab.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="h-full rounded-md text-sm font-medium transition-[color,box-shadow] hover:text-foreground aria-selected:bg-background aria-selected:text-foreground aria-selected:shadow-sm"
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  {
    tabs.map((tab, i) => (
      <div data-install-panel={tab.id} role="tabpanel" class:list={['mt-3', i !== 0 && 'hidden']}>
        <div class="overflow-hidden rounded-lg border border-border">
          <div class="flex items-center justify-between gap-3 border-b border-border bg-muted/50 py-1.5 pr-1.5 pl-3">
            <span class="truncate font-mono text-xs text-muted-foreground">{tab.file}</span>
            <button
              type="button"
              data-copy={tab.code}
              class="inline-flex h-7 shrink-0 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-muted-foreground transition-colors hover:bg-background hover:text-foreground"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
                <rect width="14" height="14" x="8" y="8" rx="2" />
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
              </svg>
              <span data-copy-label>{t('plugin.copy')}</span>
            </button>
          </div>
          {/* Wraps instead of scrolling in the narrow sidebar; the copy button
            still copies the exact text. */}
          <pre class="px-3 py-3 font-mono text-xs leading-5 whitespace-pre-wrap [overflow-wrap:anywhere]"><code>{tab.code}</code></pre>
        </div>
        <p class="mt-2.5 text-xs leading-5 text-muted-foreground">{tab.hint}</p>
      </div>
    ))
  }
  {note && <p class="mt-2 text-xs leading-5 text-muted-foreground">{note}</p>}
  {desktop && <p class="mt-2 text-xs leading-5 text-muted-foreground">{t('install.desktopNote')}</p>}
</div>

<script>
  // Delegated from `document`, so the tabs work however this script came to
  // run (first load, soft navigation, or a dev hot reload).
  document.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-install-tab]');
    const root = tab?.closest<HTMLElement>('[data-install]');
    if (!tab || !root) return;
    root.querySelectorAll('[data-install-tab]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    root.querySelectorAll<HTMLElement>('[data-install-panel]').forEach((panel) => {
      panel.classList.toggle('hidden', panel.dataset.installPanel !== tab.dataset.installTab);
    });
  });
</script>
