---
/**
 * The header every inner page opens with: the faint grid from the home hero,
 * an optional breadcrumb and eyebrow, the title, one line of description,
 * and a slot on the right for stats or actions.
 */
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  /** [label, href] pairs; the last one is the current page and gets no link. */
  breadcrumb?: [string, string?][];
  breadcrumbLabel?: string;
}
const { title, description, eyebrow, breadcrumb, breadcrumbLabel } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<div class="relative isolate">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-80 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_70%_100%_at_30%_0%,#000_30%,transparent_100%)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 sm:pt-10">
    {
      breadcrumb && (
        <nav aria-label={breadcrumbLabel}>
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground">
            {breadcrumb.map(([label, href], i) => (
              <>
                {i > 0 && <li aria-hidden="true">/</li>}
                <li class:list={[!href && 'text-foreground']} aria-current={!href ? 'page' : undefined}>
                  {href ? (
                    <a href={href} class="transition-colors hover:text-foreground">
                      {label}
                    </a>
                  ) : (
                    label
                  )}
                </li>
              </>
            ))}
          </ol>
        </nav>
      )
    }

    <header
      class:list={[
        'flex flex-col gap-8 pb-10',
        breadcrumb ? 'mt-6' : 'mt-4 sm:mt-6',
        hasAside && 'lg:flex-row lg:items-end lg:justify-between',
      ]}
    >
      <div class="max-w-2xl min-w-0">
        <slot name="icon" />
        {
          eyebrow && (
            <span class="inline-flex items-center rounded-md border border-border bg-background px-2 py-0.5 text-xs font-medium text-muted-foreground">
              {eyebrow}
            </span>
          )
        }
        <h1 class:list={['text-3xl font-semibold tracking-tight text-balance sm:text-4xl', eyebrow && 'mt-4']}>{title}</h1>
        {description && <p class="mt-3 text-base leading-7 text-muted-foreground">{description}</p>}
        <slot />
      </div>
      {hasAside && <div class="min-w-0 lg:shrink-0"><slot name="aside" /></div>}
    </header>
  </div>
</div>
