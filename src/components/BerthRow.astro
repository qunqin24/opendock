---
import type { Plugin } from '../lib/plugins';
import { categoryLabel, lampClass, lampTitle } from '../lib/plugins';
import { compactNumber, formatNumber } from '../lib/utils';

interface Props {
  plugin: Plugin;
  /** Berth number, 1-indexed. Rendered zero-padded to three digits. */
  berth: number;
}
const { plugin: p, berth } = Astro.props;
---

<a
  href={`/plugins/${p.slug}`}
  class="group relative grid grid-cols-[2.5rem_1fr_4.5rem] items-center gap-4 border-t border-border/60 px-1 py-3.5 transition-[background-color,transform] duration-200 hover:translate-x-1 hover:bg-secondary/50 sm:grid-cols-[3rem_1fr_6rem_5rem_4.25rem]"
>
  <span
    class="pointer-events-none absolute top-0 left-0 h-full w-0.5 scale-y-0 bg-dock transition-transform duration-200 group-hover:scale-y-100"
    aria-hidden="true"
  ></span>

  <span class="tabular font-mono text-[0.8125rem] text-muted-foreground/70 group-hover:text-foreground">
    {String(berth).padStart(3, '0')}
  </span>

  <span class="min-w-0">
    <span class="flex items-center gap-2.5">
      <span class:list={['lamp scale-110', lampClass[p.healthLevel]]} title={lampTitle[p.healthLevel]}></span>
      <span class="truncate text-[0.9375rem] font-medium tracking-tight group-hover:underline">
        {p.title}
      </span>
      {
        p.archived && (
          <span class="meta shrink-0 text-[0.625rem] tracking-[0.1em] text-danger">已归档</span>
        )
      }
    </span>
    <span class="mt-0.5 block truncate font-mono text-[0.6875rem] text-muted-foreground">
      {p.name}
    </span>
  </span>

  <span class="hidden truncate font-mono text-[0.6875rem] text-muted-foreground sm:block">
    {categoryLabel(p.category)}
  </span>

  <span class="text-right font-mono">
    <span
      class:list={['tabular block text-[0.8125rem]', p.starsInherited ? 'text-muted-foreground' : 'text-foreground']}
      title={p.starsInherited
        ? `所在仓库有 ${formatNumber(p.stars)} 星标，但该包只是仓库的一部分，排名时按 ${formatNumber(p.starsCredited)} 计入`
        : `${formatNumber(p.stars)} 星标`}
    >
      {compactNumber(p.stars)}{p.starsInherited && <span class="align-super text-[0.625rem]">*</span>}
    </span>
    {
      p.starsDelta7d > 0 && (
        <span class="tabular block text-[0.6875rem] text-ok" title="近 7 天新增">
          +{compactNumber(p.starsDelta7d)}
        </span>
      )
    }
  </span>

  <span
    class="tabular hidden text-right font-mono text-xs text-muted-foreground sm:block"
    title={`近 30 天 ${formatNumber(p.downloadsMonth)} 次下载`}
  >
    {compactNumber(p.downloadsMonth)}
  </span>
</a>
