---
import type { Plugin } from '../lib/plugins';
import { categoryLabel } from '../lib/plugins';
import { avatarUrl, compactNumber, timeAgo } from '../lib/utils';
import { localeFromPath, useTranslations } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
import HealthBadge from './HealthBadge.astro';

interface Props {
  plugin: Plugin;
  /** Renders a rank number in the corner (1-indexed). */
  rank?: number;
  class?: string;
}
const { plugin: p, rank, class: className = '' } = Astro.props;
---

<a
  href={`/plugins/${p.slug}`}
  class:list={[
    'group relative flex h-full flex-col rounded-xl border border-border bg-card p-5',
    // Deliberately not an elevation shadow: no transform, no wide soft
    // falloff. A tight contact shadow plus a darker edge just sharpens the
    // card against the page instead of floating it above one.
    'transition-[box-shadow,border-color] duration-150',
    'hover:border-foreground/25',
    'hover:shadow-[0_1px_2px_rgb(0_0_0/0.05),0_2px_5px_-3px_rgb(0_0_0/0.08)]',
    // A black shadow is invisible on a dark surface; deepen it there.
    'dark:hover:shadow-[0_1px_2px_rgb(0_0_0/0.35),0_2px_5px_-3px_rgb(0_0_0/0.45)]',
    className,
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0 flex-1">
      <div class="relative size-9 shrink-0 overflow-hidden rounded-lg border border-border/80 bg-secondary/50">
        {
          p.ownerAvatar ? (
            <img
              src={avatarUrl(p.ownerAvatar, 36)}
              alt={p.owner ?? p.name}
              width="36"
              height="36"
              class="size-full object-cover"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="flex size-full items-center justify-center font-mono text-xs font-bold text-foreground/70">
              {(p.owner ?? p.name).charAt(0).toUpperCase()}
            </div>
          )
        }
      </div>

      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2">
          {
            rank !== undefined && (
              <span class="tabular shrink-0 text-xs font-semibold text-muted-foreground/70">
                {String(rank).padStart(2, '0')}
              </span>
            )
          }
          <h3 class="truncate text-[0.9375rem] font-semibold tracking-tight">
            {p.title}
          </h3>
          {
            p.featured && (
              <span class="shrink-0 rounded border border-border bg-secondary px-1.5 py-px text-[0.625rem] font-medium text-secondary-foreground">
                {t('common.featured')}
              </span>
            )
          }
        </div>
        <p class="mt-0.5 truncate font-mono text-xs text-muted-foreground">{p.name}</p>
      </div>
    </div>

    <span
      class="tabular shrink-0 rounded-md border border-border bg-secondary px-2 py-1 text-xs font-semibold"
      title={t('explorer.sort.score.hint')}
    >
      {p.score.toFixed(0)}
    </span>
  </div>

  <p class="mt-3 line-clamp-2 min-h-[2.5rem] text-sm leading-5 text-muted-foreground">
    {p.description ?? t('common.noDescription')}
  </p>

  <div class="mt-4 flex items-center gap-3 text-xs text-muted-foreground">
    <span class="tabular inline-flex items-center gap-1" title={t('common.stars')}>
      <svg viewBox="0 0 16 16" fill="currentColor" class="size-3.5" aria-hidden="true">
        <path
          d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
        ></path>
      </svg>
      {compactNumber(p.stars)}
    </span>

    {
      p.starsDelta7d > 0 && (
        <span class="tabular inline-flex items-center gap-0.5 font-medium text-ok" title={t('explorer.starsDelta')}>
          +{compactNumber(p.starsDelta7d)}
        </span>
      )
    }

    <span class="tabular inline-flex items-center gap-1" title={t('explorer.downloadsTitle')}>
      <svg viewBox="0 0 16 16" fill="currentColor" class="size-3.5" aria-hidden="true">
        <path
          d="M7.25 1.75a.75.75 0 0 1 1.5 0v6.44l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V1.75ZM2.5 11a.75.75 0 0 1 .75.75v1.5h9.5v-1.5a.75.75 0 0 1 1.5 0v2.25a.75.75 0 0 1-.75.75H2.5a.75.75 0 0 1-.75-.75v-2.25A.75.75 0 0 1 2.5 11Z"
        ></path>
      </svg>
      {compactNumber(p.downloadsMonth)}
    </span>

    <span class="ml-auto truncate" title={t('common.updated')}>{timeAgo(p.pushedAt, lang)}</span>
  </div>

  <div class="mt-4 flex items-center justify-between gap-2 border-t border-border pt-3">
    <span class="truncate text-xs text-muted-foreground">{categoryLabel(p.category, lang)}</span>
    <HealthBadge signals={p.health} compact />
  </div>
</a>
